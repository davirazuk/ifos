# Minimal i3 for the IFOS Big Picture session: no bar, no gaps, the launcher
# fullscreen, and anything it opens taking the whole screen.

set $mod Mod4
font pango:JetBrainsMono Nerd Font 11

default_border none
default_floating_border none
gaps inner 0
gaps outer 0

# Also the marker that tells i3 this is a v4 config. Without a v4-only keyword
# anywhere in the file, i3 decides the format is v3 and pipes the whole thing
# through i3-migrate-config-to-v4 on every start. Everything here is fullscreen,
# so the value itself makes no difference - being stated does.
workspace_layout default

# Same palette as the desktop session and the launcher. #051a14 was a green of
# its own, visible for the moment between one application closing and the next
# painting.
client.focused          #00a86b #00a86b #04150f #7ed957   #00a86b
client.focused_inactive #1b3a2e #1b3a2e #e8f5e9 #1b3a2e   #1b3a2e
client.unfocused        #1b3a2e #10241d #7fa392 #1b3a2e   #1b3a2e
client.urgent           #f38ba8 #f38ba8 #04150f #f38ba8   #f38ba8
client.background       #0a1a14

# The wallpaper rather than a flat colour behind everything, so returning from
# an application looks like the rest of IFOS while the launcher redraws.
exec --no-startup-id feh --no-fehbg --bg-fill /usr/share/backgrounds/ifos.png

# The launcher is the session. If it exits, so does the session - that is what
# makes this feel like a console rather than a desktop with an app on top.
#
# Opening on Jogos, because that is what this session is for. The launcher puts
# the games that are actually installed at the top of that section, so picking
# this session from the login screen lands on a shelf of games rather than on
# whichever section happens to come first.
exec --no-startup-id sh -c 'ifos-launcher --category jogos; i3-msg exit'

exec --no-startup-id dunst
exec --no-startup-id picom -b
exec --no-startup-id nm-applet
exec --no-startup-id /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

for_window [class=".*"] fullscreen enable

# Dialogs are the exception. Fullscreening every window also fullscreened the
# "are you sure?" boxes and password prompts, which on a TV meant a short line
# of text alone on the whole screen with no visible parent. They float, centred,
# at their own size instead - and keep a border so they read as a separate thing.
for_window [window_type="dialog"]  fullscreen disable, floating enable, border pixel 2
for_window [window_type="utility"] fullscreen disable, floating enable, border pixel 2
for_window [window_role="pop-up"]  fullscreen disable, floating enable, border pixel 2

# Escape hatches
bindsym $mod+Return exec alacritty
bindsym $mod+Shift+q kill
bindsym $mod+Shift+e exec i3-msg exit
bindsym $mod+l exec --no-startup-id ifos-lock
bindsym $mod+F1 exec --no-startup-id alacritty -e sh -c 'cat /usr/share/ifos/keybindings.txt; read -n1 -s'

bindsym XF86AudioRaiseVolume exec --no-startup-id pamixer -i 5
bindsym XF86AudioLowerVolume exec --no-startup-id pamixer -d 5
bindsym XF86AudioMute        exec --no-startup-id pamixer -t
