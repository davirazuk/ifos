diff --git a/qobuz_dl/gui/style.css b/qobuz_dl/gui/style.css
index b606765..77dbbef 100644
--- a/qobuz_dl/gui/style.css
+++ b/qobuz_dl/gui/style.css
@@ -6567,3 +6567,83 @@ body:has(#dl-smart-discography:checked) .dynamic-filter[data-sd]::before {
     background: #ffffff;
 }
 
+/* ============================================================
+   NARROW VIEWPORT (phone-width WebView — the sidebar is a fixed
+   385px otherwise, which leaves negative/near-zero room for the
+   download/queue column on a ~360-430px phone screen)
+   ============================================================ */
+@media (max-width: 760px) {
+    /* One tall page you scroll through, instead of squeezing the sidebar
+       and main column into fixed panes — nothing here shrinks content,
+       it just stops laying it out side-by-side. */
+    .app {
+        flex-direction: column;
+        height: auto;
+        min-height: 100vh;
+        overflow-y: auto;
+        overflow-x: hidden;
+    }
+
+    .sidebar {
+        width: 100%;
+        min-width: 0;
+        height: auto;
+        max-height: none;
+        border-right: none;
+        border-bottom: 1px solid var(--border-light);
+        padding: 16px 16px 10px;
+        overflow: visible;
+    }
+
+    .sidebar-search {
+        flex: none;
+    }
+
+    .sidebar-results-scroll {
+        flex: none;
+        overflow: visible;
+        margin: 0;
+        padding: 0;
+    }
+
+    .main-content {
+        flex: none;
+        min-height: 0;
+        overflow: visible;
+        padding: 20px 16px 16px;
+    }
+
+    /* The download tab, the history panel inside it, and the history list
+       itself are all "fill remaining space and scroll internally" panes on
+       desktop (flex/grid with min-height:0). On mobile there's no fixed
+       window to fill, so each of those would clip to ~0 height instead.
+       Let them all take their natural content height and scroll as part of
+       the one page scroll on .app instead. The history list's own JS
+       virtualization keys off its scroll events / clientHeight; with
+       overflow visible those never fire and clientHeight covers the full
+       list, so it just renders everything instead of windowing — a no-op,
+       not a break. */
+    #tab-download.tab-panel.active {
+        display: block;
+        flex: none;
+        min-height: auto;
+    }
+
+    #dl-track-status-container {
+        flex: none;
+        min-height: auto;
+        overflow: visible;
+    }
+
+    .track-status-list {
+        flex: none;
+        min-height: auto;
+        max-height: none;
+        overflow-y: visible;
+    }
+
+    .options-grid {
+        grid-template-columns: 1fr;
+    }
+}
+
