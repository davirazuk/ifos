#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  ifos-theme — switch between the IFOS colour schemes
#
#      ifos-theme            show the current theme
#      ifos-theme ifms       institutional green (default — IFMS Dourados)
#      ifos-theme mocha      Catppuccin Mocha blue/mauve
#
#  Swaps the wallpaper and the accent colour used by i3, polybar and rofi.
#  Run it as your normal user; add --system (as root) to also change the login
#  screen background for everyone.
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

CFG="${XDG_CONFIG_HOME:-$HOME/.config}"
BG_DIR=/usr/share/backgrounds
STAMP="$CFG/ifos/theme"

# theme       accent   accent-dim
declare -A ACCENT=( [ifms]="#00a86b" [mocha]="#89b4fa" )
declare -A ACCENT2=( [ifms]="#7ed957" [mocha]="#cba6f7" )

usage() { sed -n '3,12p' "$0" | sed 's/^# \?//'; }

current() { [[ -f $STAMP ]] && cat "$STAMP" || echo "ifms"; }

if [[ $# -eq 0 ]]; then
    echo "Current theme: $(current)"
    echo "Available:     ${!ACCENT[*]}"
    exit 0
fi

THEME=$1
case $THEME in
    -h|--help) usage; exit 0 ;;
    ifms|mocha) ;;
    *) echo "Unknown theme: $THEME (try ifms or mocha)" >&2; exit 1 ;;
esac

WALL="$BG_DIR/ifos-$THEME.png"
[[ -f $WALL ]] || { echo "Missing wallpaper: $WALL" >&2; exit 1; }

acc=${ACCENT[$THEME]}
acc2=${ACCENT2[$THEME]}

# ── Wallpaper ────────────────────────────────────────────────────────────────
if command -v feh >/dev/null && [[ -n ${DISPLAY:-} ]]; then
    feh --no-fehbg --bg-fill "$WALL"
fi
# Make it stick across restarts of i3
if [[ -f $CFG/i3/config ]]; then
    sed -i "s|feh --no-fehbg --bg-fill .*|feh --no-fehbg --bg-fill $WALL|" "$CFG/i3/config"
fi

# ── Accent colour ────────────────────────────────────────────────────────────
old_accents='#89b4fa|#00a86b'
old_accents2='#cba6f7|#7ed957'

if [[ -f $CFG/i3/config ]]; then
    sed -ri "s/($old_accents)/$acc/g; s/($old_accents2)/$acc2/g" "$CFG/i3/config"
fi
if [[ -f $CFG/polybar/config.ini ]]; then
    sed -ri "s/^(blue\s*=\s*).*/\1$acc/; s/^(mauve\s*=\s*).*/\1$acc2/" "$CFG/polybar/config.ini"
fi
if [[ -f $CFG/rofi/catppuccin-mocha.rasi ]]; then
    sed -ri "s/^(\s*blue:\s*).*/\1$acc;/; s/^(\s*mauve:\s*).*/\1$acc2;/" "$CFG/rofi/catppuccin-mocha.rasi"
fi

mkdir -p "$(dirname "$STAMP")"; echo "$THEME" >"$STAMP"

# ── Reload ───────────────────────────────────────────────────────────────────
command -v i3-msg >/dev/null && [[ -n ${DISPLAY:-} ]] && i3-msg reload >/dev/null 2>&1

# ── Login screen (optional, needs root) ──────────────────────────────────────
if [[ ${2:-} == --system || ${1:-} == --system ]]; then
    if [[ $EUID -eq 0 ]]; then
        cp "$WALL" /usr/share/sddm/themes/ifos/background.png
        cp "$WALL" "$BG_DIR/ifos.png"
        echo "Login screen background updated."
    else
        sudo cp "$WALL" /usr/share/sddm/themes/ifos/background.png
        sudo cp "$WALL" "$BG_DIR/ifos.png"
    fi
fi

echo "Theme set to $THEME."
