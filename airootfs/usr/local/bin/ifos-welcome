#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  ifos-welcome — the first thing you see
#
#  On live media it puts the installer one keypress away. On an installed
#  system it appears once, then marks itself done and stays out of the way.
#  --autostart makes it self-suppressing; running it by hand always shows it.
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

STAMP="${XDG_CONFIG_HOME:-$HOME/.config}/ifos/welcome-done"
LIVE=0
[[ -d /run/archiso ]] && LIVE=1

# Live media always shows it; an installed system shows it once.
if [[ ${1:-} == --autostart ]] && (( ! LIVE )) && [[ -e $STAMP ]]; then
    exit 0
fi

# i3 autostarts this with no terminal attached, so put ourselves in one.
if [[ ! -t 1 && -z ${IFOS_WELCOME_TERM:-} ]]; then
    export IFOS_WELCOME_TERM=1
    # xfce4-terminal first: it draws with cairo, so it works on machines with
    # no usable OpenGL where alacritty comes up blank.
    if command -v xfce4-terminal >/dev/null; then
        exec xfce4-terminal --title ifos-welcome --hide-menubar -x "$0" "$@"
    elif command -v alacritty >/dev/null; then
        exec alacritty --class ifos-welcome -e "$0" "$@"
    elif command -v xterm >/dev/null; then
        exec xterm -class ifos-welcome -e "$0" "$@"
    fi
    exit 0
fi

c_reset=$'\033[0m'; c_b=$'\033[1m'; c_blue=$'\033[1;34m'; c_dim=$'\033[2m'

banner() {
cat <<'EOF'

    ██╗███████╗ ██████╗ ███████╗
    ██║██╔════╝██╔═══██╗██╔════╝
    ██║█████╗  ██║   ██║███████╗
    ██║██╔══╝  ██║   ██║╚════██║
    ██║██║     ╚██████╔╝███████║
    ╚═╝╚═╝      ╚═════╝ ╚══════╝
EOF
}

mark_done() {
    mkdir -p "$(dirname "$STAMP")" 2>/dev/null && : >"$STAMP" 2>/dev/null
}

menu_dialog() {
    local -a items
    if (( LIVE )); then
        items=(
            install  "Instalar o IFOS neste computador"
            launcher "Abrir o lançador do IFOS (jogos, escola, Moodle)"
            wifi     "Conectar a uma rede"
            apps     "Instalar programas (navegadores, jogos, drivers)"
            keys     "Atalhos de teclado"
            gparted  "Liberar espaço num disco (GParted)"
            shell    "Só quero um terminal"
        )
    else
        items=(
            launcher "Abrir o lançador do IFOS (jogos, escola, Moodle)"
            apps     "Instalar programas (navegadores, jogos, drivers)"
            keys     "Atalhos de teclado"
            aur      "Habilitar o acesso ao AUR (instalar o yay)"
            update   "Atualizar o sistema agora"
            shell    "Fechar"
        )
    fi
    dialog --clear --backtitle "IFOS" --title " Bem-vindo ao IFOS " \
        --cancel-label "Fechar" \
        --menu "\n$( (( LIVE )) && echo 'Você está executando o IFOS pela mídia ao vivo — nada foi gravado nos seus discos.' || echo 'Algumas coisas que você talvez queira configurar.' )\n" \
        18 72 8 "${items[@]}" 3>&1 1>&2 2>&3
}

# Writes straight to the terminal and sets `choice` itself. It must not be run
# inside $( ), or the whole menu is swallowed by the command substitution and
# the script sits invisibly on the read - which is exactly what used to happen:
# a blank window that looked like a crash.
menu_plain() {
    clear >&2
    banner >&2
    printf '\n%s  Bem-vindo ao IFOS%s\n' "$c_b" "$c_reset" >&2
    local -a keys
    if (( LIVE )); then
        printf '%s  Rodando da mídia ao vivo — nada foi gravado nos seus discos.%s\n\n' \
            "$c_dim" "$c_reset" >&2
        keys=(install launcher wifi apps keys gparted shell)
        printf '   1) Instalar o IFOS neste computador\n' >&2
        printf '   2) Abrir o lançador do IFOS\n'         >&2
        printf '   3) Conectar a uma rede\n'             >&2
        printf '   4) Instalar programas\n'              >&2
        printf '   5) Atalhos de teclado\n'              >&2
        printf '   6) Liberar espaço num disco (GParted)\n' >&2
        printf '   7) Só quero um terminal\n\n'          >&2
    else
        printf '\n' >&2
        keys=(launcher apps keys aur update shell)
        printf '   1) Open the IFOS launcher\n'          >&2
        printf '   2) Install applications\n'            >&2
        printf '   3) Keyboard shortcuts\n'              >&2
        printf '   4) Enable AUR access (install yay)\n' >&2
        printf '   5) Update the system\n'               >&2
        printf '   6) Close\n\n'                         >&2
    fi
    local reply
    read -rp "  Escolha: " reply
    if [[ $reply =~ ^[0-9]+$ ]] && (( reply >= 1 && reply <= ${#keys[@]} )); then
        choice=${keys[reply-1]}
    else
        choice=shell
    fi
}

# Decided once, in the main shell. Deciding it inside a command substitution
# would test a pipe rather than the terminal and always fall through to the
# text menu.
USE_DIALOG=0
if command -v dialog >/dev/null && [[ -t 0 && -t 2 ]]; then
    USE_DIALOG=1
fi

while :; do
    choice=""
    if (( USE_DIALOG )); then
        choice=$(menu_dialog) || { clear; mark_done; exit 0; }
        # dialog can fail at runtime (unknown TERM, tiny window). Its stderr is
        # redirected onto our stdout by the fd swap, so a failure looks like an
        # empty answer rather than an error - fall back instead of looping.
        if [[ -z $choice ]]; then
            USE_DIALOG=0
            menu_plain
        fi
    else
        menu_plain
    fi

    case ${choice:-shell} in
        install) clear; sudo install-ifos; ;;
        launcher) (ifos-launcher &) ; clear; mark_done; exit 0 ;;
        wifi)    clear; command -v nmtui >/dev/null && sudo nmtui || sudo iwctl ;;
        apps)    clear; ifos-software ;;
        keys)    clear; less -R /usr/share/ifos/keybindings.txt ;;
        gparted) (sudo gparted &) ; clear ;;
        aur)     clear; install-yay; read -rp "  Pressione Enter… " ;;
        update)  clear; sudo pacman -Syu; read -rp "  Pressione Enter… " ;;
        shell|*) clear; mark_done; exit 0 ;;
    esac
done
