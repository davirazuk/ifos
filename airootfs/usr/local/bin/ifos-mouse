#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  ifos-mouse — velocidade do mouse, e o que cada botão dele faz
#
#      ifos-mouse                 os mouses ligados e a velocidade atual
#      ifos-mouse --speed N       velocidade, de -10 (lento) a 10 (rápido)
#      ifos-mouse --faster        um passo mais rápido
#      ifos-mouse --slower        um passo mais lento
#      ifos-mouse --flat          sem aceleração (para jogos e para desenhar)
#      ifos-mouse --adaptive      com aceleração (o padrão do sistema)
#      ifos-mouse --natural       inverte o sentido da rolagem
#      ifos-mouse --test          mostra o que cada botão do mouse envia
#      ifos-mouse --learn         usa um botão do mouse para trocar a sensibilidade
#      ifos-mouse --cycle         passa para o próximo nível de sensibilidade
#      ifos-mouse --forget        desfaz o --learn
#      ifos-mouse --apply         reaplica o que foi salvo (roda no login)
#
#  The DPI button on a gaming mouse is the thing this exists for. On almost
#  every one of them that button is handled inside the mouse itself: it changes
#  the sensor's resolution in firmware and sends nothing at all to the computer.
#  Linux therefore cannot show a DPI indicator, cannot bind the button, and
#  cannot tell you it was pressed - and from the desk that is indistinguishable
#  from a broken button.
#
#  So: --test says plainly whether the button emits anything, which settles it
#  in five seconds; and the speed controls here do the job the DPI button was
#  being pressed for, on any mouse, whether or not it has one.
#
#  And when a button *does* reach the computer - which on these mice is usually
#  a side button even when the DPI one is deaf - --learn turns it into a DPI
#  button in software. Press it, and the pointer speed steps through three
#  levels with the current one named on screen. That is what the DPI button was
#  for; this is the same thing done where the computer can see it.
#
#  Mice whose DPI really can be set from the computer are the ones libratbag
#  supports, which is most Logitech, Razer, SteelSeries and Roccat hardware.
#  That is `piper` in the IFOS Software catalog, under Hardware.
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

c_reset=$'\033[0m'; c_b=$'\033[1m'; c_grn=$'\033[1;32m'
c_dim=$'\033[2m'; c_yel=$'\033[1;33m'; c_red=$'\033[1;31m'

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/ifos/mouse"
# The running watcher's pid. By pid rather than by `pkill -f`, which matches the
# pattern against every command line on the machine: a terminal displaying this
# file, an editor with it open, or the shell of a script that merely mentions
# the daemon all match, and pkill kills them. That is not hypothetical - it
# killed the shell running the test suite.
PIDFILE="${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/ifos-mouse.pid"

# The kernel's list of input devices, and the X property names libinput uses.
# A variable so the test suite can point it at a file describing a mouse this
# machine does not have.
DEVICES=${IFOS_MOUSE_DEVICES:-/proc/bus/input/devices}
# Where the event devices themselves are. Overridable for the same reason: the
# suite writes real input_event records into ordinary files and points this at
# them, which is how --learn and --daemon get tested without a mouse.
INPUT_DIR=${IFOS_MOUSE_INPUT_DIR:-/dev/input}

PROP_SPEED="libinput Accel Speed"
PROP_PROFILE="libinput Accel Profile Enabled"
PROP_NATURAL="libinput Natural Scrolling Enabled"

have_x() { [[ -n ${DISPLAY:-} ]] && command -v xinput >/dev/null 2>&1; }

# ── Which devices are mice ───────────────────────────────────────────────────
#  xinput is the right source for the X device ids, but it is not installed on
#  every machine and says nothing about what the hardware is. The kernel list
#  answers "what is plugged in"; xinput answers "what can be configured".
xinput_pointers() {   # emits: <id>\t<name>
    have_x || return 0
    # [[:space:]], not a literal space: xinput separates the name from the id
    # with a tab, and the first version of this matched nothing at all on a
    # real machine while looking perfectly reasonable.
    xinput list --short 2>/dev/null |
        sed -n 's/^[^a-zA-Z]*\(.*[^[:space:]]\)[[:space:]]*id=\([0-9][0-9]*\).*slave[[:space:]]*pointer.*/\2\t\1/p'
}

# The kernel's view: blocks that carry a "mouse" handler are pointing devices.
kernel_mice() {       # emits: <event device>\t<name>\t<vendor>:<product>
    local name="" handlers="" ids=""
    while IFS= read -r line; do
        case $line in
            'N: Name='*) name=${line#*=}; name=${name//\"/} ;;
            'I: '*)      ids=$line ;;
            'H: Handlers='*)
                handlers=${line#*=}
                if [[ $handlers == *mouse* ]]; then
                    local event="" word vendor="" product=""
                    for word in $handlers; do
                        [[ $word == event* ]] && event=$word
                    done
                    vendor=$(sed -n 's/.*Vendor=\([0-9a-f]*\).*/\1/p' <<<"$ids")
                    product=$(sed -n 's/.*Product=\([0-9a-f]*\).*/\1/p' <<<"$ids")
                    [[ -n $event ]] && printf '%s\t%s\t%s:%s\n' "$event" "$name" "$vendor" "$product"
                fi
                name=""; handlers=""; ids="" ;;
        esac
    done < "$DEVICES" 2>/dev/null
}

# Every event device belonging to one physical mouse.
#
# A gaming mouse is usually two devices, not one: the pointer, and a second
# node the kernel treats as a keyboard, which is where the extra buttons send
# their keycodes. Watching only the first meant that a DPI or side button that
# *does* reach the computer looked exactly like one that does not - the test
# was listening to the wrong half. They share a vendor and product id, which is
# what ties them back together.
sibling_events() {   # sibling_events <vendor:product>
    local want=$1 ids="" handlers="" event word
    while IFS= read -r line; do
        case $line in
            'I: '*) ids=$line ;;
            'H: Handlers='*)
                handlers=${line#*=}
                local vendor product
                vendor=$(sed -n 's/.*Vendor=\([0-9a-f]*\).*/\1/p' <<<"$ids")
                product=$(sed -n 's/.*Product=\([0-9a-f]*\).*/\1/p' <<<"$ids")
                if [[ "$vendor:$product" == "$want" ]]; then
                    event=""
                    for word in $handlers; do
                        [[ $word == event* ]] && event=$word
                    done
                    [[ -n $event ]] && printf '%s\n' "$event"
                fi
                ids=""; handlers="" ;;
        esac
    done < "$DEVICES" 2>/dev/null
}

# Vendors libratbag has a device database for. Not a promise that a given model
# is in it - only Piper can answer that - but enough to avoid sending somebody
# to install a program that will open and report nothing, which is what happens
# on the budget mice built around SINOWEALTH and Holtek controllers.
ratbag_vendor() {   # ratbag_vendor <vendor:product>
    case ${1%%:*} in
        046d|1532|1038|1e7d|0b05|2516) return 0 ;;   # Logitech, Razer, SteelSeries,
        *)                             return 1 ;;   # Roccat, ASUS, Cooler Master
    esac
}

# Touchpads are pointers too, and they have their own configuration in
# /etc/X11/xorg.conf.d/30-touchpad.conf. Changing the speed here should not
# quietly retune the laptop's touchpad along with the mouse on the desk.
is_touchpad() { [[ ${1,,} == *touchpad* || ${1,,} == *trackpad* ]]; }

# ── Reading and writing the settings ─────────────────────────────────────────
current_speed() {
    have_x || return 1
    local id name
    while IFS=$'\t' read -r id name; do
        is_touchpad "$name" && continue
        xinput list-props "$id" 2>/dev/null |
            sed -n "s/.*$PROP_SPEED ([0-9]*)://p" | tr -d ' \t' | head -1
        return 0
    done < <(xinput_pointers)
    return 1
}

apply_prop() {  # apply_prop <property> <values...>
    have_x || return 1
    local prop=$1; shift
    local id name applied=1
    while IFS=$'\t' read -r id name; do
        is_touchpad "$name" && continue
        # Not every pointer has every property - a tablet or a virtual device
        # will not - so a failure on one is not a failure overall.
        xinput list-props "$id" 2>/dev/null | grep -q "$prop" || continue
        xinput set-prop "$id" "$prop" "$@" 2>/dev/null && applied=0
    done < <(xinput_pointers)
    return $applied
}

save() {    # save <key> <value>
    mkdir -p "$(dirname "$CONF")" 2>/dev/null || return 0
    local tmp="$CONF.new"
    { [[ -f $CONF ]] && grep -v "^$1=" "$CONF"; printf '%s=%s\n' "$1" "$2"; } \
        > "$tmp" 2>/dev/null && mv "$tmp" "$CONF"
}

load() {    # load <key> [default]
    [[ -f $CONF ]] || { printf '%s' "${2:-}"; return; }
    local value
    value=$(sed -n "s/^$1=//p" "$CONF" | tail -1)
    printf '%s' "${value:-${2:-}}"
}

# libinput takes -1..1. A student setting "3" means something between the
# default and the fastest, not three times the speed.
to_libinput() { awk -v n="$1" 'BEGIN{ v=n/10; if (v>1) v=1; if (v<-1) v=-1; printf "%.2f", v }'; }
from_libinput() { awk -v v="$1" 'BEGIN{ printf "%d", (v*10) + (v>=0 ? 0.5 : -0.5) }'; }

set_speed() {   # set_speed <-10..10>
    local step=$1 value
    [[ $step =~ ^-?[0-9]+$ ]] || { echo "ifos-mouse: velocidade tem de ser um número de -10 a 10" >&2; return 2; }
    (( step > 10 )) && step=10
    (( step < -10 )) && step=-10
    value=$(to_libinput "$step")
    if apply_prop "$PROP_SPEED" "$value"; then
        save SPEED "$step"
        printf '  Velocidade do mouse: %s%s%s\n' "$c_b" "$step" "$c_reset"
        if command -v notify-send >/dev/null 2>&1; then
            timeout 3 notify-send -a IFOS -t 1200 \
                --hint=string:x-dunst-stack-tag:ifos-mouse \
                "Velocidade do mouse" "$step" 2>/dev/null || true
        fi
        return 0
    else
        printf '  %s!%s Nenhum mouse aceitou a mudança.\n' "$c_yel" "$c_reset"
        return 1
    fi
}

# ── A DPI button, in software ────────────────────────────────────────────────
#  Three levels, because that is what the button on the mouse does. Written as
#  the -10..10 scale the rest of the tool uses rather than as DPI numbers: the
#  sensor's resolution is not being changed and saying otherwise would be a lie.
CYCLE_STEPS=(0 3 6)
CYCLE_NAMES=(normal rápido "muito rápido")

cycle_speed() {
    local current index=0 i
    current=$(load SPEED 0)
    for i in "${!CYCLE_STEPS[@]}"; do
        if [[ ${CYCLE_STEPS[i]} == "$current" ]]; then
            index=$(( (i + 1) % ${#CYCLE_STEPS[@]} ))
            break
        fi
    done
    # A speed set by hand is not one of the three; the next press starts the
    # cycle from the beginning rather than pretending it was.
    apply_prop "$PROP_SPEED" "$(to_libinput "${CYCLE_STEPS[index]}")" || return 1
    save SPEED "${CYCLE_STEPS[index]}"
    printf '  Sensibilidade: %s%s%s\n' "$c_b" "${CYCLE_NAMES[index]}" "$c_reset"
    if command -v notify-send >/dev/null 2>&1; then
        timeout 3 notify-send -a IFOS -t 1200 \
            --hint=string:x-dunst-stack-tag:ifos-mouse \
            "Sensibilidade do mouse" "${CYCLE_NAMES[index]}" 2>/dev/null || true
    fi
    return 0
}

# Watch the mouse for the learned button and cycle when it is pressed.
#
# Not an X keybinding. A mouse button above the ninth has no X button number,
# and a keycode the mouse invents may map to nothing X can name - both are
# perfectly readable straight from the event device, which is also the only
# thing that works the same in the Big Picture session. The daemon is one
# python process reading a file descriptor; it costs nothing while nobody is
# pressing anything.
stop_daemon() {
    local pid
    [[ -r $PIDFILE ]] || return 0
    pid=$(cat "$PIDFILE" 2>/dev/null)
    # Only if it is still one of ours: pids are reused, and killing whatever
    # inherited this number would be worse than leaving a watcher running.
    if [[ $pid =~ ^[0-9]+$ ]] &&
       grep -qa 'ifos-mouse' "/proc/$pid/cmdline" 2>/dev/null; then
        kill "$pid" 2>/dev/null
    fi
    rm -f "$PIDFILE"
}

watch_button() {
    local code; code=$(load BUTTON)
    [[ -n $code ]] || return 1

    mkdir -p "$(dirname "$PIDFILE")" 2>/dev/null
    printf '%s\n' "$$" > "$PIDFILE" 2>/dev/null
    trap 'rm -f "$PIDFILE"' EXIT

    local ids="" name="" _event
    while IFS=$'\t' read -r _event name ids; do
        is_touchpad "$name" && continue
        break
    done < <(kernel_mice)
    [[ -n $ids ]] || return 1

    local -a nodes=()
    local node
    while IFS= read -r node; do
        [[ -n $node && -r $INPUT_DIR/$node ]] && nodes+=("$INPUT_DIR/$node")
    done < <(sibling_events "$ids")
    (( ${#nodes[@]} )) || return 1

    # The python half only reports; the cycling stays here, so there is one
    # implementation of what a press means.
    python3 -c '
import os, select, struct, sys
SIZE = struct.calcsize("llHHi")
want = int(sys.argv[1])
fds = {}
for path in sys.argv[2:]:
    try:
        fds[os.open(path, os.O_RDONLY | os.O_NONBLOCK)] = path
    except OSError:
        pass
if not fds:
    raise SystemExit(1)
while fds:
    ready, _, _ = select.select(list(fds), [], [], None)
    for fd in ready:
        try:
            data = os.read(fd, SIZE * 32)
        except BlockingIOError:
            continue
        except OSError:
            data = b""
        if not data:
            # The mouse was unplugged. Without this the descriptor stays
            # readable forever and returns nothing, and the loop spins a core
            # until the session ends.
            os.close(fd)
            del fds[fd]
            continue
        for off in range(0, len(data) - SIZE + 1, SIZE):
            _s, _u, kind, code, value = struct.unpack("llHHi", data[off:off + SIZE])
            if kind == 0x01 and value == 1 and code == want:
                print("press", flush=True)
' "$code" "${nodes[@]}" 2>/dev/null |
    while IFS= read -r _line; do
        cycle_speed >/dev/null
    done
}

learn_button() {
    local ids="" name="" _event
    while IFS=$'\t' read -r _event name ids; do
        is_touchpad "$name" && continue
        break
    done < <(kernel_mice)
    if [[ -z $ids ]]; then
        printf '\n  Nenhum mouse encontrado.\n\n'
        return 1
    fi

    local -a nodes=()
    local node
    while IFS= read -r node; do
        [[ -n $node && -r $INPUT_DIR/$node ]] && nodes+=("$INPUT_DIR/$node")
    done < <(sibling_events "$ids")
    if (( ! ${#nodes[@]} )); then
        printf '\n  %s✗%s Sem permissão para ler o mouse.\n\n' "$c_red" "$c_reset"
        return 1
    fi

    printf '\n  %sAperte agora o botão que você quer usar para trocar a sensibilidade.%s\n' \
           "$c_b" "$c_reset"
    printf '  Pode ser o de DPI, se ele funcionar, ou um dos laterais.\n'
    printf '  %sOs três botões normais não valem — eles já têm função.%s\n\n' \
           "$c_dim" "$c_reset"

    local code
    code=$(timeout 30 python3 -c '
import os, select, struct, sys
SIZE = struct.calcsize("llHHi")
ORDINARY = {0x110, 0x111, 0x112}   # left, right, middle
fds = {}
for path in sys.argv[1:]:
    try:
        fds[os.open(path, os.O_RDONLY | os.O_NONBLOCK)] = path
    except OSError:
        pass
if not fds:
    raise SystemExit(1)
while fds:
    ready, _, _ = select.select(list(fds), [], [], 30)
    if not ready:
        raise SystemExit(2)
    for fd in ready:
        try:
            data = os.read(fd, SIZE * 32)
        except BlockingIOError:
            continue
        except OSError:
            data = b""
        if not data:
            os.close(fd)
            del fds[fd]
            continue
        for off in range(0, len(data) - SIZE + 1, SIZE):
            _s, _u, kind, code, value = struct.unpack("llHHi", data[off:off + SIZE])
            if kind == 0x01 and value == 1 and code not in ORDINARY:
                print(code)
                raise SystemExit(0)
raise SystemExit(2)
' "${nodes[@]}" 2>/dev/null)

    if [[ -z $code ]]; then
        printf '  Nenhum botão chegou ao computador em 30 segundos.\n\n'
        printf '  Se você apertou o botão de DPI, é porque ele é resolvido dentro do\n'
        printf '  mouse e não manda nada — não há como usá-lo. Tente de novo com um\n'
        printf '  botão lateral, que quase sempre chega:\n\n'
        printf '    %sifos-mouse --learn%s\n\n' "$c_b" "$c_reset"
        return 1
    fi

    save BUTTON "$code"
    printf '  %s✓%s Pronto. Esse botão agora passa entre %s.\n\n' \
           "$c_grn" "$c_reset" "${CYCLE_NAMES[*]}"

    # Working immediately, not after the next login. Telling somebody their new
    # button will start working tomorrow is most of the way to it never being
    # believed to work at all. setsid so it survives this terminal closing.
    stop_daemon
    setsid "$0" --daemon </dev/null >/dev/null 2>&1 &
    disown 2>/dev/null || true
    printf '  Já pode testar: aperte o botão.\n\n'
    return 0
}

# ── Report ───────────────────────────────────────────────────────────────────
report() {
    printf '\n  %sIFOS — mouse%s\n\n' "$c_b" "$c_reset"

    local any=0 event name ids
    while IFS=$'\t' read -r event name ids; do
        [[ -n $name ]] || continue
        any=1
        if is_touchpad "$name"; then
            printf '    %s%s%s\n      %stouchpad · /dev/input/%s%s\n\n' \
                   "$c_grn" "$name" "$c_reset" "$c_dim" "$event" "$c_reset"
        else
            printf '    %s%s%s\n      %s/dev/input/%s%s\n\n' \
                   "$c_grn" "$name" "$c_reset" "$c_dim" "$event" "$c_reset"
        fi
    done < <(kernel_mice)

    (( any )) || printf '    Nenhum mouse encontrado.\n\n'

    if ! have_x; then
        if [[ -z ${DISPLAY:-} ]]; then
            printf '    %s!%s Sem sessão gráfica: a velocidade só pode ser mudada dentro do desktop.\n\n' \
                   "$c_yel" "$c_reset"
        else
            printf '    %s!%s O xinput não está instalado, então a velocidade não pode ser ajustada.\n' \
                   "$c_yel" "$c_reset"
            printf '      Instale em: IFOS Software → Hardware.\n\n'
        fi
        return
    fi

    local raw step
    raw=$(current_speed)
    if [[ -n $raw ]]; then
        step=$(from_libinput "$raw")
        printf '    Velocidade: %s%s%s  %s(-10 lento … 10 rápido)%s\n\n' \
               "$c_b" "$step" "$c_reset" "$c_dim" "$c_reset"
    fi

    cat <<EOF
    ${c_b}O botão de DPI do mouse${c_reset}
    Na maioria dos mouses de jogo esse botão é resolvido dentro do próprio
    mouse: ele troca a resolução do sensor e não manda nada para o computador.
    O sistema não tem como mostrar, nem como avisar que foi apertado — o que
    da mesa é igualzinho a um botão quebrado.

    Para saber em qual dos dois casos o seu está:

      ${c_b}ifos-mouse --test${c_reset}

    E para mudar a sensibilidade de qualquer mouse, com ou sem esse botão:

      ${c_b}ifos-mouse --speed 4${c_reset}      ${c_dim}ou --faster / --slower${c_reset}

    ${c_b}Um botão de DPI que funciona${c_reset}
    Se algum botão do mouse chega ao computador — quase sempre um dos laterais,
    mesmo quando o de DPI é surdo — ele pode virar o botão de sensibilidade:

      ${c_b}ifos-mouse --learn${c_reset}

    Aperte o botão que quiser e pronto: ele passa a alternar entre normal,
    rápido e muito rápido, dizendo na tela em qual está. Não é o DPI do sensor,
    é o mesmo efeito feito onde o computador enxerga.

EOF

    # Said about the mouse actually plugged in, because "install Piper" is bad
    # advice for most of them: the budget mice built on SINOWEALTH and Holtek
    # controllers are not in libratbag's database, and Piper opens on an empty
    # list with nothing to explain why.
    local ids=""
    while IFS=$'\t' read -r _event name ids; do
        is_touchpad "$name" && continue
        break
    done < <(kernel_mice)

    if [[ -n $ids ]] && ratbag_vendor "$ids"; then
        printf '    Este mouse é de um fabricante que o libratbag costuma reconhecer,\n'
        printf '    então dá para tentar configurar o DPI pelo computador com o\n'
        printf '    %sPiper%s (IFOS Software → Hardware).\n\n' "$c_b" "$c_reset"
    elif [[ -n $ids ]]; then
        printf '    O %sPiper%s provavelmente não vai reconhecer este mouse: ele cobre\n' \
               "$c_b" "$c_reset"
        printf '    principalmente Logitech, Razer, SteelSeries e Roccat. A velocidade\n'
        printf '    aqui funciona em qualquer mouse e é o caminho para este.\n\n'
    fi
}

# ── Test ─────────────────────────────────────────────────────────────────────
test_buttons() {
    local event="" name="" ids="" chosen_name="" chosen_ids=""
    while IFS=$'\t' read -r event name ids; do
        is_touchpad "$name" && continue
        chosen_name=$name
        chosen_ids=$ids
        break
    done < <(kernel_mice)

    if [[ -z ${event:-} || -z $chosen_name ]]; then
        printf '\n  Nenhum mouse encontrado para testar.\n\n'
        return 1
    fi

    # Every node of this mouse, not just the pointer one: the extra buttons
    # live on the keyboard-looking sibling, and that is exactly where a DPI
    # button would show up if it shows up at all.
    local -a nodes=() unreadable=()
    local node
    while IFS= read -r node; do
        [[ -n $node ]] || continue
        if [[ -r $INPUT_DIR/$node ]]; then
            nodes+=("$INPUT_DIR/$node")
        else
            unreadable+=("$node")
        fi
    done < <(sibling_events "$chosen_ids")

    if (( ! ${#nodes[@]} )); then
        printf '\n  %s✗%s Sem permissão para ler %s.\n\n' \
               "$c_red" "$c_reset" "${unreadable[*]:-$INPUT_DIR/$event}"
        return 1
    fi

    printf '\n  %sTestando: %s%s\n' "$c_b" "$chosen_name" "$c_reset"
    printf '  %s%d dispositivo(s) deste mouse: %s%s\n' \
           "$c_dim" "${#nodes[@]}" "${nodes[*]##*/}" "$c_reset"
    printf '  Aperte todos os botões, inclusive o de DPI.\n'
    printf '  %sCtrl+C para sair.%s\n\n' "$c_dim" "$c_reset"

    python3 - "${nodes[@]}" <<'PY'
import os
import select
import struct
import sys

# struct input_event: two longs of timestamp, then type, code and value.
SIZE = struct.calcsize("llHHi")
EV_KEY = 0x01

BUTTONS = {
    0x110: "botão esquerdo",
    0x111: "botão direito",
    0x112: "botão do meio",
    0x113: "botão lateral (voltar)",
    0x114: "botão lateral (avançar)",
    0x115: "botão extra (forward)",
    0x116: "botão extra (back)",
    0x117: "botão extra (task)",
}

# The keys a gaming mouse most often sends from a side or DPI button, because
# that is what its Windows software binds by default.
KEYS = {
    0x01: "Esc", 0x0e: "Backspace", 0x0f: "Tab", 0x1c: "Enter",
    0x1d: "Ctrl esquerdo", 0x2a: "Shift esquerdo", 0x38: "Alt esquerdo",
    0x3b: "F1", 0x3c: "F2", 0x3d: "F3", 0x3e: "F4", 0x3f: "F5", 0x40: "F6",
    0x41: "F7", 0x42: "F8", 0x43: "F9", 0x44: "F10", 0x57: "F11", 0x58: "F12",
    0x9d: "Ctrl direito", 0x64: "Alt direito", 0x7d: "tecla Super/Windows",
    0x8f: "Copiar", 0x83: "Colar", 0x9b: "Recortar",
    0x9e: "Voltar (navegador)", 0x9f: "Avançar (navegador)",
}

handles = {}
for path in sys.argv[1:]:
    try:
        handles[os.open(path, os.O_RDONLY | os.O_NONBLOCK)] = path
    except OSError as error:
        print("  não deu para abrir %s: %s" % (path, error))

if not handles:
    raise SystemExit(1)

seen = set()
try:
    while True:
        # Several devices at once: the pointer, and the keyboard-looking node
        # the same mouse also presents. Reading them one at a time would block
        # on whichever was quiet and miss the button being pressed.
        ready, _, _ = select.select(list(handles), [], [], None)
        for fd in ready:
            try:
                data = os.read(fd, SIZE * 32)
            except (BlockingIOError, OSError):
                continue
            for offset in range(0, len(data) - SIZE + 1, SIZE):
                _sec, _usec, kind, code, value = struct.unpack(
                    "llHHi", data[offset:offset + SIZE])
                if kind != EV_KEY or value != 1:   # presses only, not releases
                    continue
                if code in BUTTONS:
                    print("  %s" % BUTTONS[code])
                elif 0x100 <= code <= 0x151:
                    print("  botão sem nome (código %d) — dá para usar em atalhos" % code)
                elif code in KEYS:
                    print("  o mouse enviou a tecla %s (código %d)" % (KEYS[code], code))
                else:
                    # A keyboard keycode is the good case: it means the button
                    # does reach the computer and can be bound to something.
                    print("  o mouse enviou uma tecla de teclado (código %d)" % code)
                seen.add(code)
                sys.stdout.flush()
except KeyboardInterrupt:
    pass

extra = [c for c in seen if c not in (0x110, 0x111, 0x112)]
print()
if not extra:
    print("  Só os três botões normais apareceram.")
    print("  Se o botão de DPI não imprimiu nada, ele é resolvido dentro do")
    print("  mouse e não chega ao computador — não há o que consertar aqui.")
    print("  Use  ifos-mouse --speed N  para mudar a sensibilidade.")
else:
    print("  Os botões acima chegam ao computador e podem virar atalhos.")
    print("  Anote o código e diga qual é; dá para amarrar a qualquer coisa.")
PY
}

# ── Entry points ─────────────────────────────────────────────────────────────
case ${1:-} in
    -h|--help) sed -n '3,14p' "$0" | sed 's/^# \?//'; exit 0 ;;

    --speed)   set_speed "${2:-}"; exit $? ;;
    --faster)  set_speed "$(( $(load SPEED 0) + 2 ))"; exit $? ;;
    --slower)  set_speed "$(( $(load SPEED 0) - 2 ))"; exit $? ;;

    --flat)
        # 0 1: adaptive off, flat on. Flat is what a game wants - the pointer
        # moves the same distance for the same hand movement every time.
        if apply_prop "$PROP_PROFILE" 0 1; then
            save PROFILE flat; printf '  Aceleração desligada.\n'; exit 0
        fi
        printf '  %s!%s Nenhum mouse aceitou a mudança.\n' "$c_yel" "$c_reset"; exit 1 ;;
    --adaptive)
        if apply_prop "$PROP_PROFILE" 1 0; then
            save PROFILE adaptive; printf '  Aceleração ligada.\n'; exit 0
        fi
        printf '  %s!%s Nenhum mouse aceitou a mudança.\n' "$c_yel" "$c_reset"; exit 1 ;;
    --natural)
        natural=$(load NATURAL 0)
        natural=$(( natural ? 0 : 1 ))
        if apply_prop "$PROP_NATURAL" "$natural"; then
            save NATURAL "$natural"
            printf '  Rolagem invertida: %s.\n' \
                   "$( ((natural)) && echo ligada || echo desligada)"
            exit 0
        fi
        printf '  %s!%s Nenhum mouse aceitou a mudança.\n' "$c_yel" "$c_reset"; exit 1 ;;

    --apply)
        # Runs at login, after the settings have been chosen once. Silent: it
        # has no terminal to print to and nothing to say when it works.
        have_x || exit 0
        [[ -f $CONF ]] || exit 0
        speed=$(load SPEED)
        [[ -n $speed ]] && apply_prop "$PROP_SPEED" "$(to_libinput "$speed")"
        [[ $(load PROFILE) == flat ]]     && apply_prop "$PROP_PROFILE" 0 1
        [[ $(load PROFILE) == adaptive ]] && apply_prop "$PROP_PROFILE" 1 0
        natural=$(load NATURAL)
        [[ -n $natural ]] && apply_prop "$PROP_NATURAL" "$natural"
        exit 0 ;;

    --test)    test_buttons; exit $? ;;
    --learn)   learn_button; exit $? ;;
    --cycle)   cycle_speed; exit $? ;;
    --forget)
        save BUTTON ""
        printf '  O botão foi esquecido.\n'; exit 0 ;;
    --daemon)
        # Started at login next to --apply. Exits immediately and silently when
        # no button has been learned, which is the ordinary case.
        watch_button; exit $? ;;
    "")        report; exit 0 ;;
    *)  printf 'ifos-mouse: opção desconhecida: %s\n' "$1" >&2
        sed -n '3,14p' "$0" | sed 's/^# \?//' >&2
        exit 2 ;;
esac
