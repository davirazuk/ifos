#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  ifos-mouse — velocidade do mouse, e o que cada botão dele faz
#
#      ifos-mouse                 os mouses ligados e a velocidade atual
#      ifos-mouse --speed N       velocidade, de -10 (lento) a 10 (rápido)
#      ifos-mouse --faster        um passo mais rápido
#      ifos-mouse --slower        um passo mais lento
#      ifos-mouse --flat          sem aceleração (para jogos e para desenhar)
#      ifos-mouse --adaptive      com aceleração (o padrão do sistema)
#      ifos-mouse --natural       inverte o sentido da rolagem
#      ifos-mouse --test          mostra o que cada botão do mouse envia
#      ifos-mouse --apply         reaplica o que foi salvo (roda no login)
#
#  The DPI button on a gaming mouse is the thing this exists for. On almost
#  every one of them that button is handled inside the mouse itself: it changes
#  the sensor's resolution in firmware and sends nothing at all to the computer.
#  Linux therefore cannot show a DPI indicator, cannot bind the button, and
#  cannot tell you it was pressed - and from the desk that is indistinguishable
#  from a broken button.
#
#  So: --test says plainly whether the button emits anything, which settles it
#  in five seconds; and the speed controls here do the job the DPI button was
#  being pressed for, on any mouse, whether or not it has one.
#
#  Mice whose DPI really can be set from the computer are the ones libratbag
#  supports, which is most Logitech, Razer, SteelSeries and Roccat hardware.
#  That is `piper` in the IFOS Software catalog, under Hardware.
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

c_reset=$'\033[0m'; c_b=$'\033[1m'; c_grn=$'\033[1;32m'
c_dim=$'\033[2m'; c_yel=$'\033[1;33m'; c_red=$'\033[1;31m'

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/ifos/mouse"

# The kernel's list of input devices, and the X property names libinput uses.
# A variable so the test suite can point it at a file describing a mouse this
# machine does not have.
DEVICES=${IFOS_MOUSE_DEVICES:-/proc/bus/input/devices}

PROP_SPEED="libinput Accel Speed"
PROP_PROFILE="libinput Accel Profile Enabled"
PROP_NATURAL="libinput Natural Scrolling Enabled"

have_x() { [[ -n ${DISPLAY:-} ]] && command -v xinput >/dev/null 2>&1; }

# ── Which devices are mice ───────────────────────────────────────────────────
#  xinput is the right source for the X device ids, but it is not installed on
#  every machine and says nothing about what the hardware is. The kernel list
#  answers "what is plugged in"; xinput answers "what can be configured".
xinput_pointers() {   # emits: <id>\t<name>
    have_x || return 0
    # [[:space:]], not a literal space: xinput separates the name from the id
    # with a tab, and the first version of this matched nothing at all on a
    # real machine while looking perfectly reasonable.
    xinput list --short 2>/dev/null |
        sed -n 's/^[^a-zA-Z]*\(.*[^[:space:]]\)[[:space:]]*id=\([0-9][0-9]*\).*slave[[:space:]]*pointer.*/\2\t\1/p'
}

# The kernel's view: blocks that carry a "mouse" handler are pointing devices.
kernel_mice() {       # emits: <event device>\t<name>
    local name="" handlers=""
    while IFS= read -r line; do
        case $line in
            'N: Name='*) name=${line#*=}; name=${name//\"/} ;;
            'H: Handlers='*)
                handlers=${line#*=}
                if [[ $handlers == *mouse* ]]; then
                    local event="" word
                    for word in $handlers; do
                        [[ $word == event* ]] && event=$word
                    done
                    [[ -n $event ]] && printf '%s\t%s\n' "$event" "$name"
                fi
                name=""; handlers="" ;;
        esac
    done < "$DEVICES" 2>/dev/null
}

# Touchpads are pointers too, and they have their own configuration in
# /etc/X11/xorg.conf.d/30-touchpad.conf. Changing the speed here should not
# quietly retune the laptop's touchpad along with the mouse on the desk.
is_touchpad() { [[ ${1,,} == *touchpad* || ${1,,} == *trackpad* ]]; }

# ── Reading and writing the settings ─────────────────────────────────────────
current_speed() {
    have_x || return 1
    local id name
    while IFS=$'\t' read -r id name; do
        is_touchpad "$name" && continue
        xinput list-props "$id" 2>/dev/null |
            sed -n "s/.*$PROP_SPEED ([0-9]*)://p" | tr -d ' \t' | head -1
        return 0
    done < <(xinput_pointers)
    return 1
}

apply_prop() {  # apply_prop <property> <values...>
    have_x || return 1
    local prop=$1; shift
    local id name applied=1
    while IFS=$'\t' read -r id name; do
        is_touchpad "$name" && continue
        # Not every pointer has every property - a tablet or a virtual device
        # will not - so a failure on one is not a failure overall.
        xinput list-props "$id" 2>/dev/null | grep -q "$prop" || continue
        xinput set-prop "$id" "$prop" "$@" 2>/dev/null && applied=0
    done < <(xinput_pointers)
    return $applied
}

save() {    # save <key> <value>
    mkdir -p "$(dirname "$CONF")" 2>/dev/null || return 0
    local tmp="$CONF.new"
    { [[ -f $CONF ]] && grep -v "^$1=" "$CONF"; printf '%s=%s\n' "$1" "$2"; } \
        > "$tmp" 2>/dev/null && mv "$tmp" "$CONF"
}

load() {    # load <key> [default]
    [[ -f $CONF ]] || { printf '%s' "${2:-}"; return; }
    local value
    value=$(sed -n "s/^$1=//p" "$CONF" | tail -1)
    printf '%s' "${value:-${2:-}}"
}

# libinput takes -1..1. A student setting "3" means something between the
# default and the fastest, not three times the speed.
to_libinput() { awk -v n="$1" 'BEGIN{ v=n/10; if (v>1) v=1; if (v<-1) v=-1; printf "%.2f", v }'; }
from_libinput() { awk -v v="$1" 'BEGIN{ printf "%d", (v*10) + (v>=0 ? 0.5 : -0.5) }'; }

set_speed() {   # set_speed <-10..10>
    local step=$1 value
    [[ $step =~ ^-?[0-9]+$ ]] || { echo "ifos-mouse: velocidade tem de ser um número de -10 a 10" >&2; return 2; }
    (( step > 10 )) && step=10
    (( step < -10 )) && step=-10
    value=$(to_libinput "$step")
    if apply_prop "$PROP_SPEED" "$value"; then
        save SPEED "$step"
        printf '  Velocidade do mouse: %s%s%s\n' "$c_b" "$step" "$c_reset"
        if command -v notify-send >/dev/null 2>&1; then
            notify-send -a IFOS -t 1200 --hint=string:x-dunst-stack-tag:ifos-mouse \
                "Velocidade do mouse" "$step" 2>/dev/null || true
        fi
        return 0
    else
        printf '  %s!%s Nenhum mouse aceitou a mudança.\n' "$c_yel" "$c_reset"
        return 1
    fi
}

# ── Report ───────────────────────────────────────────────────────────────────
report() {
    printf '\n  %sIFOS — mouse%s\n\n' "$c_b" "$c_reset"

    local any=0 event name
    while IFS=$'\t' read -r event name; do
        [[ -n $name ]] || continue
        any=1
        if is_touchpad "$name"; then
            printf '    %s%s%s\n      %stouchpad · /dev/input/%s%s\n\n' \
                   "$c_grn" "$name" "$c_reset" "$c_dim" "$event" "$c_reset"
        else
            printf '    %s%s%s\n      %s/dev/input/%s%s\n\n' \
                   "$c_grn" "$name" "$c_reset" "$c_dim" "$event" "$c_reset"
        fi
    done < <(kernel_mice)

    (( any )) || printf '    Nenhum mouse encontrado.\n\n'

    if ! have_x; then
        if [[ -z ${DISPLAY:-} ]]; then
            printf '    %s!%s Sem sessão gráfica: a velocidade só pode ser mudada dentro do desktop.\n\n' \
                   "$c_yel" "$c_reset"
        else
            printf '    %s!%s O xinput não está instalado, então a velocidade não pode ser ajustada.\n' \
                   "$c_yel" "$c_reset"
            printf '      Instale em: IFOS Software → Hardware.\n\n'
        fi
        return
    fi

    local raw step
    raw=$(current_speed)
    if [[ -n $raw ]]; then
        step=$(from_libinput "$raw")
        printf '    Velocidade: %s%s%s  %s(-10 lento … 10 rápido)%s\n\n' \
               "$c_b" "$step" "$c_reset" "$c_dim" "$c_reset"
    fi

    cat <<EOF
    ${c_b}O botão de DPI do mouse${c_reset}
    Na maioria dos mouses de jogo esse botão é resolvido dentro do próprio
    mouse: ele troca a resolução do sensor e não manda nada para o computador.
    O sistema não tem como mostrar, nem como avisar que foi apertado — o que
    da mesa é igualzinho a um botão quebrado.

    Para saber em qual dos dois casos o seu está:

      ${c_b}ifos-mouse --test${c_reset}

    E para mudar a sensibilidade de qualquer mouse, com ou sem esse botão:

      ${c_b}ifos-mouse --speed 4${c_reset}      ${c_dim}ou --faster / --slower${c_reset}

    Mouses cujo DPI dá mesmo para configurar pelo computador são os que o
    libratbag reconhece — boa parte de Logitech, Razer, SteelSeries e Roccat.
    É o ${c_b}Piper${c_reset}, no IFOS Software → Hardware.

EOF
}

# ── Test ─────────────────────────────────────────────────────────────────────
test_buttons() {
    local event="" name="" chosen_name=""
    while IFS=$'\t' read -r event name; do
        is_touchpad "$name" && continue
        chosen_name=$name
        break
    done < <(kernel_mice)

    if [[ -z ${event:-} || -z $chosen_name ]]; then
        printf '\n  Nenhum mouse encontrado para testar.\n\n'
        return 1
    fi
    if [[ ! -r /dev/input/$event ]]; then
        printf '\n  %s✗%s Sem permissão para ler /dev/input/%s.\n\n' "$c_red" "$c_reset" "$event"
        return 1
    fi

    printf '\n  %sTestando: %s%s\n' "$c_b" "$chosen_name" "$c_reset"
    printf '  Aperte todos os botões, inclusive o de DPI.\n'
    printf '  %sCtrl+C para sair.%s\n\n' "$c_dim" "$c_reset"

    python3 - "/dev/input/$event" <<'PY'
import struct
import sys

# struct input_event: two longs of timestamp, then type, code and value.
SIZE = struct.calcsize("llHHi")
EV_KEY = 0x01
EV_REL = 0x02

BUTTONS = {
    0x110: "botão esquerdo",
    0x111: "botão direito",
    0x112: "botão do meio",
    0x113: "botão lateral (voltar)",
    0x114: "botão lateral (avançar)",
    0x115: "botão extra (forward)",
    0x116: "botão extra (back)",
    0x117: "botão extra (task)",
}

try:
    handle = open(sys.argv[1], "rb", buffering=0)
except OSError as error:
    print("  não deu para abrir: %s" % error)
    raise SystemExit(1)

seen = set()
try:
    while True:
        data = handle.read(SIZE)
        if not data or len(data) < SIZE:
            break
        _sec, _usec, kind, code, value = struct.unpack("llHHi", data)
        if kind != EV_KEY or value != 1:      # presses only, not releases
            continue
        if code in BUTTONS:
            print("  %s" % BUTTONS[code])
        elif 0x100 <= code <= 0x151:
            print("  botão sem nome (código %d) — dá para usar em atalhos" % code)
        else:
            # Some mice send keyboard keycodes for their extra buttons, which
            # is the case where the DPI button *can* be bound to something.
            print("  tecla de teclado (código %d) — o mouse está enviando uma tecla" % code)
        seen.add(code)
except KeyboardInterrupt:
    pass

print()
if len(seen) <= 3:
    print("  Só os botões normais apareceram.")
    print("  Se o botão de DPI não imprimiu nada, ele é resolvido dentro do")
    print("  mouse e não chega ao computador — não há o que consertar aqui.")
    print("  Use  ifos-mouse --speed N  para mudar a sensibilidade.")
PY
}

# ── Entry points ─────────────────────────────────────────────────────────────
case ${1:-} in
    -h|--help) sed -n '3,14p' "$0" | sed 's/^# \?//'; exit 0 ;;

    --speed)   set_speed "${2:-}"; exit $? ;;
    --faster)  set_speed "$(( $(load SPEED 0) + 2 ))"; exit $? ;;
    --slower)  set_speed "$(( $(load SPEED 0) - 2 ))"; exit $? ;;

    --flat)
        # 0 1: adaptive off, flat on. Flat is what a game wants - the pointer
        # moves the same distance for the same hand movement every time.
        if apply_prop "$PROP_PROFILE" 0 1; then
            save PROFILE flat; printf '  Aceleração desligada.\n'; exit 0
        fi
        printf '  %s!%s Nenhum mouse aceitou a mudança.\n' "$c_yel" "$c_reset"; exit 1 ;;
    --adaptive)
        if apply_prop "$PROP_PROFILE" 1 0; then
            save PROFILE adaptive; printf '  Aceleração ligada.\n'; exit 0
        fi
        printf '  %s!%s Nenhum mouse aceitou a mudança.\n' "$c_yel" "$c_reset"; exit 1 ;;
    --natural)
        natural=$(load NATURAL 0)
        natural=$(( natural ? 0 : 1 ))
        if apply_prop "$PROP_NATURAL" "$natural"; then
            save NATURAL "$natural"
            printf '  Rolagem invertida: %s.\n' \
                   "$( ((natural)) && echo ligada || echo desligada)"
            exit 0
        fi
        printf '  %s!%s Nenhum mouse aceitou a mudança.\n' "$c_yel" "$c_reset"; exit 1 ;;

    --apply)
        # Runs at login, after the settings have been chosen once. Silent: it
        # has no terminal to print to and nothing to say when it works.
        have_x || exit 0
        [[ -f $CONF ]] || exit 0
        speed=$(load SPEED)
        [[ -n $speed ]] && apply_prop "$PROP_SPEED" "$(to_libinput "$speed")"
        [[ $(load PROFILE) == flat ]]     && apply_prop "$PROP_PROFILE" 0 1
        [[ $(load PROFILE) == adaptive ]] && apply_prop "$PROP_PROFILE" 1 0
        natural=$(load NATURAL)
        [[ -n $natural ]] && apply_prop "$PROP_NATURAL" "$natural"
        exit 0 ;;

    --test)    test_buttons; exit $? ;;
    "")        report; exit 0 ;;
    *)  printf 'ifos-mouse: opção desconhecida: %s\n' "$1" >&2
        sed -n '3,14p' "$0" | sed 's/^# \?//' >&2
        exit 2 ;;
esac
