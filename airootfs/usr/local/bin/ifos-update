#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  ifos-update — update the system and pull the latest IFOS files from GitHub
#
#      ifos-update                 packages, IFOS files, your desktop, restart
#      ifos-update --no-reboot     everything, but stay running
#      ifos-update --no-dotfiles   leave your own ~/.config alone
#      ifos-update --ifos-only     skip pacman, just refresh the IFOS files
#      ifos-only --packages        only pacman -Syu
#      ifos-update --repair        only repair known-broken files in your ~/.config
#      ifos-update --check         show what would change, change nothing
#
#  The IFOS parts of the system - the launcher, the software catalog, the
#  installer, the themes, the wallpapers, the login screen - all live in the git
#  repository. This pulls the current version of them onto an installed machine,
#  so a system installed months ago can be brought up to date without
#  reinstalling.
#
#  One command brings a machine fully current: packages, the IFOS files, the
#  desktop configuration in your home directory, and a restart so all of it is
#  actually in effect. Updating the defaults in /etc/skel does not reach a home
#  directory that already exists, which is why the desktop refresh is part of
#  the normal run rather than something to remember to ask for. Your previous
#  configuration is copied aside first, and --no-dotfiles skips it entirely.
#
#  System-level settings that only install-ifos used to write - the GRUB theme
#  among them - are applied here too, so an already-installed machine picks them
#  up rather than waiting for a reinstall.
#
#  Package updates come from Arch as usual; this does not hold anything back.
#
#  Configuration: /etc/ifos/update.conf
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

CONF=/etc/ifos/update.conf
STATE=/var/lib/ifos
REPO_DIR="$STATE/repo"

IFOS_REPO="https://github.com/davirazuk/ifos.git"
IFOS_BRANCH="main"
[[ -r $CONF ]] && . "$CONF"

c_reset=$'\033[0m'; c_b=$'\033[1m'; c_grn=$'\033[1;32m'
c_blue=$'\033[1;34m'; c_yel=$'\033[1;33m'; c_red=$'\033[1;31m'
info() { printf '%s==>%s %s\n' "$c_blue" "$c_reset" "$*"; }
ok()   { printf '%s  ✓%s %s\n' "$c_grn"  "$c_reset" "$*"; }
warn() { printf '%s  !%s %s\n' "$c_yel"  "$c_reset" "$*"; }
die()  { printf '%s==> ERROR:%s %s\n' "$c_red" "$c_reset" "$*" >&2; exit 1; }

DO_PACKAGES=1
DO_IFOS=1
# On by default: a home directory that already exists never sees a change to
# /etc/skel, so leaving this opt-in meant the desktop half of an update
# silently did not arrive unless you knew to ask for it.
DO_DOTFILES=1
DO_REBOOT=1
CHECK_ONLY=0
REPAIR_ONLY=0
REBOOT_DELAY=15

for arg in "$@"; do
    case $arg in
        -h|--help)     sed -n '3,28p' "$0" | sed 's/^# \?//'; exit 0 ;;
        --ifos-only)   DO_PACKAGES=0 ;;
        --packages)    DO_IFOS=0 ;;
        --dotfiles)    DO_DOTFILES=1 ;;   # kept: it is the default now
        --no-dotfiles) DO_DOTFILES=0 ;;
        --no-reboot)   DO_REBOOT=0 ;;
        --repair)      REPAIR_ONLY=1; DO_PACKAGES=0 ;;
        --check)       CHECK_ONLY=1 ;;
        *) die "unknown option '$arg' (try --help)" ;;
    esac
done

# Nothing that only inspects the system should restart it.
(( CHECK_ONLY || REPAIR_ONLY )) && DO_REBOOT=0

# ── Restarting ───────────────────────────────────────────────────────────────
# Most of what an update lands only takes effect on a fresh boot: a new kernel,
# the GRUB theme, the X input configuration, the login screen, and the desktop
# files that the running i3 session already read. Finishing without a restart
# left a machine in a half-updated state that looked like the update had not
# worked.
#
# It is a countdown rather than an immediate reboot, because this can be run on
# a machine with something unsaved on screen.
finish_and_reboot() {
    if (( ! DO_REBOOT )); then
        warn "Not restarting. Some of this takes effect only after a restart."
        return 0
    fi

    trap 'printf "\n"; warn "Restart cancelled - do it when convenient."; exit 0' INT
    printf '\n%s==>%s Restarting in %ss. Press Ctrl+C to stay.\n' \
           "$c_blue" "$c_reset" "$REBOOT_DELAY"
    local i
    for (( i = REBOOT_DELAY; i > 0; i-- )); do
        printf '\r      %2ds ' "$i"
        sleep 1
    done
    printf '\r%*s\r' 12 ''
    trap - INT

    $SUDO systemctl reboot
}

# ── The login screen ─────────────────────────────────────────────────────────
# The theme itself is copied by branding-sync, but SDDM only uses it if
# something actually selects it - and the selection can be overridden from three
# places. SDDM reads /usr/lib/sddm/sddm.conf.d/*, then /etc/sddm.conf.d/*, then
# /etc/sddm.conf, and the last one wins. A stray /etc/sddm.conf therefore beats
# our drop-in silently, and the greeter falls back to its stock look with no
# error anywhere.
configure_sddm() {
    local theme_dir=/usr/share/sddm/themes/ifos
    local drop_in=/etc/sddm.conf.d/ifos.conf

    command -v sddm >/dev/null || return 0

    if [[ ! -d $theme_dir ]]; then
        warn "The IFOS login theme is missing from $theme_dir."
        warn "Run: sudo ifos-update --ifos-only"
        return 0
    fi

    # Make sure our drop-in exists and selects the theme.
    if [[ ! -f $drop_in ]]; then
        info "Restoring the IFOS login screen configuration…"
        $SUDO install -d -m 0755 /etc/sddm.conf.d
        $SUDO tee "$drop_in" >/dev/null <<'SDDMCFG'
[General]
DisplayServer=x11
Numlock=on

[Theme]
Current=ifos
CursorTheme=Adwaita
CursorSize=24

[Users]
HideShells=/usr/bin/nologin,/sbin/nologin
SDDMCFG
        ok "Login screen configuration restored"
    elif ! grep -qE '^[[:space:]]*Current[[:space:]]*=[[:space:]]*ifos[[:space:]]*$' "$drop_in"; then
        info "Selecting the IFOS login theme…"
        if grep -qE '^[[:space:]]*Current[[:space:]]*=' "$drop_in"; then
            $SUDO sed -i 's|^[[:space:]]*Current[[:space:]]*=.*|Current=ifos|' "$drop_in"
        elif grep -q '^\[Theme\]' "$drop_in"; then
            $SUDO sed -i '/^\[Theme\]/a Current=ifos' "$drop_in"
        else
            $SUDO tee -a "$drop_in" >/dev/null <<'SDDMTHEME'

[Theme]
Current=ifos
SDDMTHEME
        fi
        ok "Login theme selected"
    fi

    # A single-file /etc/sddm.conf overrides every drop-in. If one exists and
    # points somewhere else, that is the actual reason the greeter looks stock.
    if [[ -f /etc/sddm.conf ]] &&
       grep -qE '^[[:space:]]*Current[[:space:]]*=' /etc/sddm.conf &&
       ! grep -qE '^[[:space:]]*Current[[:space:]]*=[[:space:]]*ifos[[:space:]]*$' /etc/sddm.conf; then
        warn "/etc/sddm.conf selects a different theme and overrides the drop-in."
        info "Pointing it at the IFOS theme…"
        $SUDO sed -i 's|^[[:space:]]*Current[[:space:]]*=.*|Current=ifos|' /etc/sddm.conf &&
            ok "/etc/sddm.conf now selects ifos"
    fi
}

# ── The boot menu ────────────────────────────────────────────────────────────
# branding-sync drops the GRUB theme into /usr/share/grub/themes/ifos, but
# /etc/default/grub is only written by install-ifos. On a machine that is
# already installed the theme would therefore sit there unused, and the boot
# menu would stay stock blue-on-black. Wire it up here instead.
configure_grub() {
    local theme=/usr/share/grub/themes/ifos/theme.txt
    local cfg=/etc/default/grub

    [[ -f $theme ]] || return 0
    [[ -f $cfg   ]] || return 0
    command -v grub-mkconfig >/dev/null || return 0
    # Only touch machines that actually boot through GRUB.
    [[ -f /boot/grub/grub.cfg ]] || return 0

    if grep -qF "GRUB_THEME=\"$theme\"" "$cfg"; then
        return 0                      # already ours; do not rewrite every update
    fi

    info "Applying the IFOS boot menu theme…"
    $SUDO sed -i '/^GRUB_THEME=/d; /^GRUB_GFXMODE=/d; /^GRUB_GFXPAYLOAD_LINUX=/d; /^GRUB_TERMINAL_OUTPUT=/d' "$cfg"
    # gfxterm is what makes a theme render at all, and without an explicit
    # GFXMODE some firmware drops to 640x480 and the theme looks cramped.
    $SUDO tee -a "$cfg" >/dev/null <<GRUBCFG
GRUB_THEME="$theme"
GRUB_GFXMODE="1920x1080,1366x768,auto"
GRUB_GFXPAYLOAD_LINUX="keep"
GRUB_TERMINAL_OUTPUT="gfxterm"
GRUBCFG

    if $SUDO grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1; then
        ok "Boot menu themed - you will see it on the next restart"
    else
        warn "grub-mkconfig failed. Run it by hand: sudo grub-mkconfig -o /boot/grub/grub.cfg"
    fi
}

# ── Power profiles ───────────────────────────────────────────────────────────
# The package itself arrives through install_missing_packages, but an installed
# package is not a running service. Only install-ifos enables this, so a machine
# set up before it existed would get the bar's profile button with nothing
# behind it: powerprofilesctl reaches the daemon over D-Bus, and the module
# stays blank rather than reporting anything.
configure_power_profiles() {
    local unit=power-profiles-daemon.service

    systemctl cat "$unit" >/dev/null 2>&1 || return 0
    [[ $(systemctl is-enabled "$unit" 2>/dev/null) == enabled ]] && return 0

    info "Enabling power profiles…"
    if $SUDO systemctl enable --now "$unit" >/dev/null 2>&1; then
        ok "Power profiles enabled - the profile button in the bar works now"
    else
        warn "Could not enable $unit; the bar's power profile button will stay blank."
    fi
}

# ── Packages this system should have but might be missing ───────────────────
# pacman -Syu only upgrades packages that are already installed; a package
# newly added to install-ifos's list after this machine was set up (like the
# qt5-quickcontrols2 fix for the login theme) never reaches an existing
# machine through any other path than this.
install_missing_packages() {
    local installer="$REPO_DIR/airootfs/usr/local/bin/install-ifos"
    [[ -f $installer ]] || return 0

    local -a wanted
    mapfile -t wanted < <(
        sed -n '/^PACKAGES=(/,/^)/p' "$installer" |
            sed '1d;$d;s/#.*//' | tr -s ' \t' '\n' | grep -vE '^\s*$'
    )
    (( ${#wanted[@]} )) || return 0

    local -a missing=() pkg
    for pkg in "${wanted[@]}"; do
        pacman -Qq "$pkg" &>/dev/null || missing+=("$pkg")
    done
    (( ${#missing[@]} )) || return 0

    info "Installing packages new to IFOS: ${missing[*]}"
    $SUDO pacman -S --needed --noconfirm "${missing[@]}" \
        || warn "Some new packages failed to install."
}

# ── Repairs for home directories that already exist ──────────────────────────
# Prefer the copy in the fresh checkout: on a machine whose ifos-update is a
# release behind, that is the only one carrying the newest repairs.
repair_dotfiles() {
    local script
    for script in "$REPO_DIR/airootfs/usr/share/ifos/repair-dotfiles.sh" \
                  /usr/share/ifos/repair-dotfiles.sh; do
        [[ -f $script ]] || continue
        info "Checking your configuration for known problems…"
        if [[ $EUID -eq 0 ]]; then
            # Run as root: no single "your" home to repair, so do them all.
            bash "$script" --all-users "$@"
        else
            bash "$script" "$@"
        fi
        return 0
    done
    warn "repair-dotfiles.sh is missing; skipping the configuration repairs."
}

if (( REPAIR_ONLY )); then
    (( CHECK_ONLY )) && { repair_dotfiles --check; exit 0; }
    repair_dotfiles
    exit 0
fi

[[ -d /run/archiso ]] && die "This updates an installed system; you are on live media."

SUDO=""; [[ $EUID -ne 0 ]] && SUDO=sudo
command -v git >/dev/null || die "git is not installed:  sudo pacman -S git"

# ── Packages ─────────────────────────────────────────────────────────────────
if (( DO_PACKAGES )) && (( ! CHECK_ONLY )); then
    info "Updating packages…"
    $SUDO pacman -Syu || warn "pacman did not finish cleanly."
    if command -v yay >/dev/null && [[ $EUID -ne 0 ]]; then
        info "Updating AUR packages…"
        yay -Sua --noconfirm || warn "Some AUR packages failed to build."
    fi
fi

if (( ! DO_IFOS )); then
    # --packages: a kernel or driver upgrade still wants the restart.
    finish_and_reboot
    exit 0
fi

# ── Fetch the repository ─────────────────────────────────────────────────────
$SUDO install -d -m 0755 "$STATE"

if [[ -d $REPO_DIR/.git ]]; then
    info "Fetching $IFOS_REPO…"
    $SUDO git -C "$REPO_DIR" remote set-url origin "$IFOS_REPO"
    $SUDO git -C "$REPO_DIR" fetch --depth 1 origin "$IFOS_BRANCH" \
        || die "Could not reach the repository. Is it public, and are you online?"
    $SUDO git -C "$REPO_DIR" reset --hard "origin/$IFOS_BRANCH" >/dev/null
else
    info "Cloning $IFOS_REPO…"
    $SUDO git clone --depth 1 --branch "$IFOS_BRANCH" "$IFOS_REPO" "$REPO_DIR" \
        || die "Could not clone the repository. Is it public, and are you online?"
fi

NEW_COMMIT=$($SUDO git -C "$REPO_DIR" rev-parse --short HEAD)
NEW_DATE=$($SUDO git -C "$REPO_DIR" log -1 --format=%cd --date=short)
OLD_COMMIT=$(cat "$STATE/applied-commit" 2>/dev/null || echo none)

printf '\n  installed: %s\n  available: %s (%s)\n\n' "$OLD_COMMIT" "$NEW_COMMIT" "$NEW_DATE"

if (( DO_PACKAGES )) && (( ! CHECK_ONLY )); then
    install_missing_packages
fi

if [[ $OLD_COMMIT == "$NEW_COMMIT" ]]; then
    ok "Already up to date."
    # The system files are current, but a home directory created before a fix
    # landed is not, so still look for repairs.
    if (( CHECK_ONLY )); then
        repair_dotfiles --check
        exit 0
    fi
    if (( ! DO_DOTFILES )); then
        repair_dotfiles
        finish_and_reboot
        exit 0
    fi
fi

if (( CHECK_ONLY )); then
    repair_dotfiles --check
    info "Changes since $OLD_COMMIT:"
    if [[ $OLD_COMMIT != none ]]; then
        $SUDO git -C "$REPO_DIR" log --oneline "$OLD_COMMIT..$NEW_COMMIT" 2>/dev/null | head -20 \
            || $SUDO git -C "$REPO_DIR" log --oneline -10
    else
        $SUDO git -C "$REPO_DIR" log --oneline -10
    fi
    exit 0
fi

# ── Apply the IFOS files ─────────────────────────────────────────────────────
SYNC="$REPO_DIR/airootfs/usr/share/ifos/branding-sync.sh"
[[ -x $SYNC ]] || $SUDO chmod +x "$SYNC" 2>/dev/null
[[ -f $SYNC ]] || die "The checkout looks wrong: $SYNC is missing."

info "Applying IFOS files…"
# branding-sync copies from a live root; point it at the checkout's airootfs.
$SUDO env IFOS_SOURCE="$REPO_DIR/airootfs" "$SYNC" / || die "Applying the update failed."

$SUDO sh -c "printf '%s\n' '$NEW_COMMIT' > '$STATE/applied-commit'"
ok "IFOS files updated to $NEW_COMMIT"

configure_sddm
configure_grub
configure_power_profiles

# ── The user's own configuration ─────────────────────────────────────────────
if (( DO_DOTFILES )) && [[ $EUID -eq 0 ]]; then
    # Refusing outright would now abort a normal `sudo ifos-update`, since this
    # step is no longer opt-in. root has no single home directory to refresh,
    # so skip just this part and say so.
    warn "Running as root, so your personal desktop files were not refreshed."
    warn "Run ifos-update as your own user to pick up the new defaults."
    repair_dotfiles
elif (( DO_DOTFILES )); then
    BACKUP="$HOME/.config-backup-$(date +%Y%m%d-%H%M%S)"
    info "Backing up your configuration to $BACKUP…"
    mkdir -p "$BACKUP"
    for d in i3 polybar rofi dunst picom fish alacritty xfce4 gtk-3.0 gtk-4.0 fastfetch; do
        [[ -e "$HOME/.config/$d" ]] && cp -a "$HOME/.config/$d" "$BACKUP/" 2>/dev/null
    done
    cp -a /etc/skel/.config/. "$HOME/.config/" 2>/dev/null
    for f in .xprofile .xinitrc .dialogrc .bashrc; do
        [[ -f /etc/skel/$f ]] && cp -a "/etc/skel/$f" "$HOME/$f"
    done
    ok "Dotfiles refreshed (your previous ones are in $BACKUP)"

    # This runs on every update now, so the backups would otherwise pile up in
    # the home directory one per run. Keep the last few and drop the rest.
    mapfile -t OLD_BACKUPS < <(
        ls -1d "$HOME"/.config-backup-* 2>/dev/null | sort -r | tail -n +4
    )
    if (( ${#OLD_BACKUPS[@]} )); then
        rm -rf -- "${OLD_BACKUPS[@]}" 2>/dev/null &&
            info "Removed ${#OLD_BACKUPS[@]} older configuration backup(s)."
    fi
else
    repair_dotfiles
    warn "Your ~/.config was left alone because of --no-dotfiles."
fi

# ── Colours ──────────────────────────────────────────────────────────────────
# Everything that just landed carries the green defaults - the new /etc/skel,
# and the login screen under /usr/share/sddm, which the update overwrote. If
# this account chose another theme, paint them back rather than leave the
# desktop and the greeter disagreeing. The stamp lives in ~/.config/ifos, which
# /etc/skel does not carry, so it survives even a --dotfiles refresh.
THEME_STAMP="${XDG_CONFIG_HOME:-$HOME/.config}/ifos/theme"
if [[ $EUID -ne 0 && -r $THEME_STAMP ]] && command -v ifos-theme >/dev/null; then
    WANT=$(<"$THEME_STAMP")
    if [[ -n $WANT && $WANT != ifms ]]; then
        info "Re-applying your $WANT theme…"
        ifos-theme "$WANT" --system >/dev/null &&
            ok "Theme restored: $WANT (desktop and login screen)"
    fi
fi

cat <<EOF

${c_grn}✓ IFOS is up to date.${c_reset}

    ${c_b}ifos-update --check${c_reset}        see what changed
    ${c_b}ifos-update --repair${c_reset}       re-check your ~/.config for known problems
    ${c_b}ifos-update --no-dotfiles${c_reset}  update without touching your ~/.config
    ${c_b}ifos-update --no-reboot${c_reset}    update without restarting afterwards

EOF

finish_and_reboot
