#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  ifos-update — update the system and pull the latest IFOS files from GitHub
#
#      ifos-update              update packages, then the IFOS files
#      ifos-update --ifos-only  skip pacman, just refresh the IFOS files
#      ifos-only --packages     only pacman -Syu
#      ifos-update --dotfiles   also refresh your ~/.config from the new defaults
#      ifos-update --repair     only repair known-broken files in your ~/.config
#      ifos-update --check      show what would change, change nothing
#
#  The IFOS parts of the system - the launcher, the software catalog, the
#  installer, the themes, the wallpapers, the login screen - all live in the git
#  repository. This pulls the current version of them onto an installed machine,
#  so a system installed months ago can be brought up to date without
#  reinstalling.
#
#  Updating the defaults in /etc/skel does not touch a home directory that
#  already exists, so afterwards this also runs the small, idempotent repairs in
#  repair-dotfiles.sh against your ~/.config. Those keep your colours; only
#  --dotfiles replaces your configuration outright.
#
#  Package updates come from Arch as usual; this does not hold anything back.
#
#  Configuration: /etc/ifos/update.conf
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

CONF=/etc/ifos/update.conf
STATE=/var/lib/ifos
REPO_DIR="$STATE/repo"

IFOS_REPO="https://github.com/davirazuk/ifos.git"
IFOS_BRANCH="main"
[[ -r $CONF ]] && . "$CONF"

c_reset=$'\033[0m'; c_b=$'\033[1m'; c_grn=$'\033[1;32m'
c_blue=$'\033[1;34m'; c_yel=$'\033[1;33m'; c_red=$'\033[1;31m'
info() { printf '%s==>%s %s\n' "$c_blue" "$c_reset" "$*"; }
ok()   { printf '%s  ✓%s %s\n' "$c_grn"  "$c_reset" "$*"; }
warn() { printf '%s  !%s %s\n' "$c_yel"  "$c_reset" "$*"; }
die()  { printf '%s==> ERROR:%s %s\n' "$c_red" "$c_reset" "$*" >&2; exit 1; }

DO_PACKAGES=1
DO_IFOS=1
DO_DOTFILES=0
CHECK_ONLY=0
REPAIR_ONLY=0

for arg in "$@"; do
    case $arg in
        -h|--help)   sed -n '3,25p' "$0" | sed 's/^# \?//'; exit 0 ;;
        --ifos-only) DO_PACKAGES=0 ;;
        --packages)  DO_IFOS=0 ;;
        --dotfiles)  DO_DOTFILES=1 ;;
        --repair)    REPAIR_ONLY=1; DO_PACKAGES=0 ;;
        --check)     CHECK_ONLY=1 ;;
        *) die "unknown option '$arg' (try --help)" ;;
    esac
done

# ── Repairs for home directories that already exist ──────────────────────────
# Prefer the copy in the fresh checkout: on a machine whose ifos-update is a
# release behind, that is the only one carrying the newest repairs.
repair_dotfiles() {
    local script
    for script in "$REPO_DIR/airootfs/usr/share/ifos/repair-dotfiles.sh" \
                  /usr/share/ifos/repair-dotfiles.sh; do
        [[ -f $script ]] || continue
        info "Checking your configuration for known problems…"
        if [[ $EUID -eq 0 ]]; then
            # Run as root: no single "your" home to repair, so do them all.
            bash "$script" --all-users "$@"
        else
            bash "$script" "$@"
        fi
        return 0
    done
    warn "repair-dotfiles.sh is missing; skipping the configuration repairs."
}

if (( REPAIR_ONLY )); then
    (( CHECK_ONLY )) && { repair_dotfiles --check; exit 0; }
    repair_dotfiles
    exit 0
fi

[[ -d /run/archiso ]] && die "This updates an installed system; you are on live media."

SUDO=""; [[ $EUID -ne 0 ]] && SUDO=sudo
command -v git >/dev/null || die "git is not installed:  sudo pacman -S git"

# ── Packages ─────────────────────────────────────────────────────────────────
if (( DO_PACKAGES )) && (( ! CHECK_ONLY )); then
    info "Updating packages…"
    $SUDO pacman -Syu || warn "pacman did not finish cleanly."
    if command -v yay >/dev/null && [[ $EUID -ne 0 ]]; then
        info "Updating AUR packages…"
        yay -Sua --noconfirm || warn "Some AUR packages failed to build."
    fi
fi

(( DO_IFOS )) || exit 0

# ── Fetch the repository ─────────────────────────────────────────────────────
$SUDO install -d -m 0755 "$STATE"

if [[ -d $REPO_DIR/.git ]]; then
    info "Fetching $IFOS_REPO…"
    $SUDO git -C "$REPO_DIR" remote set-url origin "$IFOS_REPO"
    $SUDO git -C "$REPO_DIR" fetch --depth 1 origin "$IFOS_BRANCH" \
        || die "Could not reach the repository. Is it public, and are you online?"
    $SUDO git -C "$REPO_DIR" reset --hard "origin/$IFOS_BRANCH" >/dev/null
else
    info "Cloning $IFOS_REPO…"
    $SUDO git clone --depth 1 --branch "$IFOS_BRANCH" "$IFOS_REPO" "$REPO_DIR" \
        || die "Could not clone the repository. Is it public, and are you online?"
fi

NEW_COMMIT=$($SUDO git -C "$REPO_DIR" rev-parse --short HEAD)
NEW_DATE=$($SUDO git -C "$REPO_DIR" log -1 --format=%cd --date=short)
OLD_COMMIT=$(cat "$STATE/applied-commit" 2>/dev/null || echo none)

printf '\n  installed: %s\n  available: %s (%s)\n\n' "$OLD_COMMIT" "$NEW_COMMIT" "$NEW_DATE"

if [[ $OLD_COMMIT == "$NEW_COMMIT" ]]; then
    ok "Already up to date."
    # The system files are current, but a home directory created before a fix
    # landed is not, so still look for repairs.
    if (( CHECK_ONLY )); then
        repair_dotfiles --check
        exit 0
    fi
    (( DO_DOTFILES )) || { repair_dotfiles; exit 0; }
fi

if (( CHECK_ONLY )); then
    repair_dotfiles --check
    info "Changes since $OLD_COMMIT:"
    if [[ $OLD_COMMIT != none ]]; then
        $SUDO git -C "$REPO_DIR" log --oneline "$OLD_COMMIT..$NEW_COMMIT" 2>/dev/null | head -20 \
            || $SUDO git -C "$REPO_DIR" log --oneline -10
    else
        $SUDO git -C "$REPO_DIR" log --oneline -10
    fi
    exit 0
fi

# ── Apply the IFOS files ─────────────────────────────────────────────────────
SYNC="$REPO_DIR/airootfs/usr/share/ifos/branding-sync.sh"
[[ -x $SYNC ]] || $SUDO chmod +x "$SYNC" 2>/dev/null
[[ -f $SYNC ]] || die "The checkout looks wrong: $SYNC is missing."

info "Applying IFOS files…"
# branding-sync copies from a live root; point it at the checkout's airootfs.
$SUDO env IFOS_SOURCE="$REPO_DIR/airootfs" "$SYNC" / || die "Applying the update failed."

$SUDO sh -c "printf '%s\n' '$NEW_COMMIT' > '$STATE/applied-commit'"
ok "IFOS files updated to $NEW_COMMIT"

# ── The user's own configuration ─────────────────────────────────────────────
if (( DO_DOTFILES )); then
    [[ $EUID -eq 0 ]] && die "Run --dotfiles as your normal user, not root."
    BACKUP="$HOME/.config-backup-$(date +%Y%m%d-%H%M%S)"
    info "Backing up your configuration to $BACKUP…"
    mkdir -p "$BACKUP"
    for d in i3 polybar rofi dunst picom fish alacritty xfce4 gtk-3.0 gtk-4.0; do
        [[ -e "$HOME/.config/$d" ]] && cp -a "$HOME/.config/$d" "$BACKUP/" 2>/dev/null
    done
    cp -a /etc/skel/.config/. "$HOME/.config/" 2>/dev/null
    for f in .xprofile .xinitrc .dialogrc .bashrc; do
        [[ -f /etc/skel/$f ]] && cp -a "/etc/skel/$f" "$HOME/$f"
    done
    ok "Dotfiles refreshed (your previous ones are in $BACKUP)"
    command -v i3-msg >/dev/null && [[ -n ${DISPLAY:-} ]] && i3-msg restart >/dev/null 2>&1
else
    repair_dotfiles
    warn "Your ~/.config was otherwise left alone. Use --dotfiles to take the new"
    warn "defaults (your current ones get backed up first)."
fi

# ── Colours ──────────────────────────────────────────────────────────────────
# Everything that just landed carries the green defaults - the new /etc/skel,
# and the login screen under /usr/share/sddm, which the update overwrote. If
# this account chose another theme, paint them back rather than leave the
# desktop and the greeter disagreeing. The stamp lives in ~/.config/ifos, which
# /etc/skel does not carry, so it survives even a --dotfiles refresh.
THEME_STAMP="${XDG_CONFIG_HOME:-$HOME/.config}/ifos/theme"
if [[ $EUID -ne 0 && -r $THEME_STAMP ]] && command -v ifos-theme >/dev/null; then
    WANT=$(<"$THEME_STAMP")
    if [[ -n $WANT && $WANT != ifms ]]; then
        info "Re-applying your $WANT theme…"
        ifos-theme "$WANT" --system >/dev/null &&
            ok "Theme restored: $WANT (desktop and login screen)"
    fi
fi

cat <<EOF

${c_grn}✓ IFOS is up to date.${c_reset}

    ${c_b}ifos-update --check${c_reset}      see what changed
    ${c_b}ifos-update --repair${c_reset}     re-check your ~/.config for known problems
    ${c_b}ifos-update --dotfiles${c_reset}   also take the new desktop defaults

EOF
