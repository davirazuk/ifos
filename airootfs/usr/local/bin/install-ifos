#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  install-ifos — guided IFOS installer
#
#  Asks a short list of plain questions, shows you exactly what it is about to
#  do, and only then touches the disk. Three disk modes:
#
#    alongside  create IFOS in unallocated free space, reuse the existing EFI
#               partition, and leave every other operating system untouched
#    partition  format one partition you pick, nothing else
#    wipe       erase an entire disk (requires typing ERASE)
#
#  install-ifos --advanced  hands over to upstream archinstall instead.
#
#  Everything is logged to /var/log/ifos-install.log
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

LOG=/var/log/ifos-install.log
MNT=/mnt
MIN_ROOT_MIB=20480            # 20 GiB — refuse to install into less
ESP_TYPE_GUID=c12a7328-f81f-11d2-ba4b-00a0c93ec93b

c_reset=$'\033[0m'; c_b=$'\033[1m'; c_blue=$'\033[1;34m'; c_grn=$'\033[1;32m'
c_yel=$'\033[1;33m'; c_red=$'\033[1;31m'

info() { printf '%s==>%s %s\n' "$c_blue" "$c_reset" "$*"; }
ok()   { printf '%s  ✓%s %s\n' "$c_grn"  "$c_reset" "$*"; }
warn() { printf '%s  !%s %s\n' "$c_yel"  "$c_reset" "$*"; }
die()  { printf '\n%s==> ERROR:%s %s\n' "$c_red" "$c_reset" "$*" >&2
         printf '    A full log is at %s\n' "$LOG" >&2; exit 1; }

# ── Interaction helpers (dialog when available, prompts otherwise) ───────────
USE_DIALOG=0
command -v dialog >/dev/null && [[ -t 0 && -t 1 ]] && USE_DIALOG=1
DTITLE="IFOS Installer"

msg() {
    if (( USE_DIALOG )); then
        dialog --backtitle "$DTITLE" --msgbox "\n$1" 16 74
    else
        printf '\n  %s\n' "$1"; read -rp "  Press Enter… "
    fi
}

ask_input() {   # ask_input <prompt> <default>
    local prompt=$1 default=${2:-} out
    if (( USE_DIALOG )); then
        out=$(dialog --backtitle "$DTITLE" --inputbox "\n$prompt" 10 66 "$default" \
              3>&1 1>&2 2>&3) || return 1
    else
        read -rp "  $prompt [${default}]: " out
    fi
    printf '%s' "${out:-$default}"
}

ask_password() {
    local prompt=$1 a b
    while :; do
        if (( USE_DIALOG )); then
            a=$(dialog --backtitle "$DTITLE" --insecure --passwordbox "\n$prompt" 10 66 \
                3>&1 1>&2 2>&3) || return 1
            b=$(dialog --backtitle "$DTITLE" --insecure --passwordbox "\nConfirm $prompt" 10 66 \
                3>&1 1>&2 2>&3) || return 1
        else
            read -rsp "  $prompt: " a; echo
            read -rsp "  Confirm: "   b; echo
        fi
        [[ -z $a ]] && { msg "The password cannot be empty."; continue; }
        [[ $a == "$b" ]] && { printf '%s' "$a"; return 0; }
        msg "Those did not match. Try again."
    done
}

ask_menu() {    # ask_menu <prompt> <tag1> <desc1> [tag2 desc2 ...]
    local prompt=$1; shift
    if (( USE_DIALOG )); then
        dialog --backtitle "$DTITLE" --menu "\n$prompt" 20 78 10 "$@" 3>&1 1>&2 2>&3
    else
        local -a tags=() descs=()
        while (( $# )); do tags+=("$1"); descs+=("$2"); shift 2; done
        printf '\n  %s\n\n' "$prompt"
        local i
        for i in "${!tags[@]}"; do printf '   %2d) %-14s %s\n' "$((i+1))" "${tags[i]}" "${descs[i]}"; done
        local c; read -rp $'\n  Choice: ' c
        [[ $c =~ ^[0-9]+$ ]] && (( c>=1 && c<=${#tags[@]} )) && printf '%s' "${tags[c-1]}"
    fi
}

ask_yesno() {
    local q=$1
    if (( USE_DIALOG )); then
        dialog --backtitle "$DTITLE" --yesno "\n$q" 12 70
    else
        local a; read -rp "  $q [y/N] " a; [[ ${a,,} == y* ]]
    fi
}

# ── Preflight ────────────────────────────────────────────────────────────────
[[ $EUID -eq 0 ]] || die "Run this as root:  sudo install-ifos"

case ${1:-} in
    --advanced) exec archinstall --config /usr/share/ifos/archinstall-preset.json ;;
    -h|--help)  sed -n '3,17p' "$0" | sed 's/^# \?//'; exit 0 ;;
esac

FIRMWARE=BIOS
[[ -d /sys/firmware/efi/efivars ]] && FIRMWARE=UEFI

ping -c1 -W3 archlinux.org &>/dev/null || \
    die "No internet connection. Connect first (tray applet, or run nmtui) and try again."

for tool in sgdisk parted mkfs.ext4 mkfs.vfat pacstrap genfstab arch-chroot lsblk reflector; do
    command -v "$tool" >/dev/null || die "Missing required tool: $tool"
done

clear
msg "Welcome to the IFOS installer.

This asks a handful of questions, shows you a summary, and touches nothing until
you confirm at the very end.

Firmware detected: $FIRMWARE

To keep another operating system, pick 'alongside' at the disk step — it only
uses unallocated free space and never reformats an existing partition. If you
have no free space yet, quit and make some with GParted first (it is installed)."

# ── Questions ────────────────────────────────────────────────────────────────
KEYMAP=$(ask_input "Keyboard layout / layout do teclado (br-abnt2, us, ...)" "br-abnt2") || exit 1
LOCALE=$(ask_input "System locale / idioma do sistema" "pt_BR.UTF-8")                   || exit 1

# Brazilian default, overridden by geolocation when there is a network.
TZ_GUESS=$(curl -fsS --max-time 5 https://ipapi.co/timezone 2>/dev/null)
[[ -f /usr/share/zoneinfo/${TZ_GUESS:-nope} ]] || TZ_GUESS=America/Campo_Grande
TIMEZONE=$(ask_input "Time zone (Region/City)" "$TZ_GUESS")   || exit 1
[[ -f /usr/share/zoneinfo/$TIMEZONE ]] || die "Unknown time zone: $TIMEZONE"

HOSTNAME=$(ask_input "Computer name (hostname)" "ifos")       || exit 1

while :; do
    USERNAME=$(ask_input "Your username (lowercase, no spaces)" "") || exit 1
    [[ $USERNAME =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] && break
    msg "'$USERNAME' is not a valid Linux username. Use lowercase letters, digits, - and _."
done
USERPASS=$(ask_password "Password for $USERNAME") || exit 1

if ask_yesno "Set a separate root (administrator) password?

Choosing No locks the root account and you administer the machine with sudo,
which is what most desktop distributions do."; then
    ROOTPASS=$(ask_password "Root password") || exit 1
else
    ROOTPASS=""
fi

# ── Disk selection ───────────────────────────────────────────────────────────
# Never offer the medium we are running from.
LIVE_DISK=""
live_src=$(findmnt -no SOURCE /run/archiso/bootmnt 2>/dev/null)
[[ -n $live_src ]] && LIVE_DISK=$(lsblk -npo PKNAME "$live_src" 2>/dev/null | head -1)

mapfile -t disks < <(lsblk -dpno NAME,SIZE,MODEL,TYPE | awk '$NF=="disk"')
disk_menu=()
for d in "${disks[@]}"; do
    dev=$(awk '{print $1}' <<<"$d")
    [[ -n $LIVE_DISK && $dev == "$LIVE_DISK" ]] && continue
    disk_menu+=("$dev" "$(sed "s|^$dev *||; s/ disk$//" <<<"$d")")
done
(( ${#disk_menu[@]} )) || die "No installable disks found."

DISK=$(ask_menu "Which disk should IFOS be installed on?" "${disk_menu[@]}") || exit 1
[[ -b $DISK ]] || die "Not a block device: $DISK"

clear
printf '\n%s  Current layout of %s%s\n\n' "$c_b" "$DISK" "$c_reset"
lsblk -o NAME,SIZE,FSTYPE,LABEL,MOUNTPOINTS "$DISK"
printf '\n'
read -rp "  Press Enter to continue… "

find_free_space() {     # biggest unallocated gap: "START_MIB END_MIB SIZE_MIB"
    parted -m -s "$1" unit MiB print free 2>/dev/null |
    awk -F: '/:free;$/ {
        s=$2; e=$3; sz=$4
        sub(/MiB/,"",s); sub(/MiB/,"",e); sub(/MiB/,"",sz)
        if (sz+0 > best+0) { best=sz+0; bs=s+0; be=e+0 }
    } END { if (best>0) printf "%d %d %d\n", bs, be, best }'
}

find_esp() {
    lsblk -rpno NAME,PARTTYPE "$1" |
        awk -v g="$ESP_TYPE_GUID" 'tolower($2)==g {print $1; exit}'
}

FREE_START=0; FREE_END=0; FREE_SIZE=0
read -r FREE_START FREE_END FREE_SIZE < <(find_free_space "$DISK") || true
FREE_SIZE=${FREE_SIZE:-0}
EXISTING_ESP=$(find_esp "$DISK")

mode_menu=()
(( FREE_SIZE >= MIN_ROOT_MIB )) && \
    mode_menu+=(alongside "Use the $((FREE_SIZE/1024)) GiB of free space, keep everything else")
mode_menu+=(partition "Format one existing partition that I pick")
mode_menu+=(wipe      "Erase the WHOLE disk and start clean")

MODE=$(ask_menu "How should IFOS use $DISK?" "${mode_menu[@]}") || exit 1

TARGET_PART=""
case $MODE in
  alongside)
    [[ $FIRMWARE == UEFI && -z $EXISTING_ESP ]] && \
        die "No EFI partition found on $DISK to share. Use 'wipe', or create an ESP with GParted."
    ;;
  partition)
    mapfile -t parts < <(lsblk -rpno NAME,SIZE,FSTYPE,MOUNTPOINTS "$DISK" | awk 'NR>1')
    (( ${#parts[@]} )) || die "No partitions on $DISK to choose from."
    part_menu=()
    for p in "${parts[@]}"; do
        pdev=$(awk '{print $1}' <<<"$p")
        part_menu+=("$pdev" "$(sed "s|^$pdev *||" <<<"$p")")
    done
    TARGET_PART=$(ask_menu "Which partition should be FORMATTED as the IFOS root?
Everything on it is lost. Other partitions are untouched." "${part_menu[@]}") || exit 1
    [[ -b $TARGET_PART ]] || die "Not a partition: $TARGET_PART"
    findmnt -rno TARGET "$TARGET_PART" &>/dev/null && die "$TARGET_PART is currently mounted."
    psize=$(( $(blockdev --getsize64 "$TARGET_PART") / 1024 / 1024 ))
    (( psize >= MIN_ROOT_MIB )) || \
        die "$TARGET_PART is only $((psize/1024)) GiB; IFOS needs at least $((MIN_ROOT_MIB/1024)) GiB."
    ;;
  wipe)
    ask_yesno "This ERASES EVERYTHING on $DISK, including any other operating
system installed on it.

Are you sure?" || exit 1
    read -rp "  Type ERASE in capitals to confirm: " confirm
    [[ $confirm == ERASE ]] || die "Not confirmed — nothing was changed."
    ;;
  *) exit 1 ;;
esac

FSTYPE=$(ask_menu "Filesystem for the IFOS root partition" \
    ext4  "Simple and reliable (recommended)" \
    btrfs "Snapshots and compression") || exit 1

RAM_MIB=$(( $(awk '/MemTotal/{print $2}' /proc/meminfo) / 1024 ))
SWAP_DEFAULT=$(( RAM_MIB > 8192 ? 8192 : RAM_MIB ))
SWAP_MIB=$(ask_input "Swap file size in MiB (0 for none)" "$SWAP_DEFAULT") || exit 1
[[ $SWAP_MIB =~ ^[0-9]+$ ]] || SWAP_MIB=0

# ── Summary ──────────────────────────────────────────────────────────────────
case $MODE in
  alongside) plan="Create a new $(( (FREE_END-FREE_START)/1024 )) GiB $FSTYPE partition in the free space on $DISK.
Reuse the existing EFI partition ${EXISTING_ESP:-(BIOS boot)} without formatting it.
No existing partition is formatted, resized or removed." ;;
  partition) plan="Format $TARGET_PART as $FSTYPE and install IFOS onto it.
Reuse the existing EFI partition ${EXISTING_ESP:-(BIOS boot)} without formatting it.
No other partition is touched." ;;
  wipe)      plan="ERASE ALL DATA on $DISK, then create a fresh EFI + $FSTYPE layout." ;;
esac

clear
cat <<EOF

${c_b}  IFOS is about to install with these settings${c_reset}

    Disk mode      ${c_b}$MODE${c_reset}
    Disk           $DISK
    Filesystem     $FSTYPE
    Swap file      $SWAP_MIB MiB
    Firmware       $FIRMWARE
    Hostname       $HOSTNAME
    User           $USERNAME $( [[ -n $ROOTPASS ]] && echo '(+ separate root password)' || echo '(root locked, sudo only)' )
    Time zone      $TIMEZONE
    Locale         $LOCALE / keymap $KEYMAP

${c_yel}  What happens to the disk:${c_reset}
$(sed 's/^/    /' <<<"$plan")

EOF
read -rp "  Type YES to start installing, anything else to abort: " go
[[ $go == YES ]] || die "Aborted — nothing was changed."

# ── Everything below is logged ───────────────────────────────────────────────
exec > >(tee -a "$LOG") 2>&1
printf '\n===== IFOS install started %s =====\n' "$(date -Is)"

cleanup() { set +e; swapoff "$MNT/swapfile" 2>/dev/null; umount -R "$MNT" 2>/dev/null; }
trap cleanup EXIT

snapshot_parts() { lsblk -rpno NAME "$DISK" | tail -n +2 | sort; }

ROOT_PART=""
ESP_PART="$EXISTING_ESP"

case $MODE in
  wipe)
    info "Wiping $DISK…"
    swapoff -a 2>/dev/null
    umount -R "$MNT" 2>/dev/null
    wipefs -af "$DISK"       || die "wipefs failed on $DISK"
    sgdisk --zap-all "$DISK" || die "Could not clear the partition table."
    if [[ $FIRMWARE == UEFI ]]; then
        sgdisk -n 1:1M:+1G -t 1:ef00 -c 1:"EFI system" "$DISK" || die "Creating the ESP failed."
        sgdisk -n 2:0:0    -t 2:8300 -c 2:"IFOS root"  "$DISK" || die "Creating the root partition failed."
    else
        sgdisk -n 1:1M:+2M -t 1:ef02 -c 1:"BIOS boot"  "$DISK" || die "Creating the BIOS boot partition failed."
        sgdisk -n 2:0:0    -t 2:8300 -c 2:"IFOS root"  "$DISK" || die "Creating the root partition failed."
    fi
    partprobe "$DISK"; udevadm settle; sleep 1
    mapfile -t newparts < <(snapshot_parts)
    (( ${#newparts[@]} >= 2 )) || die "The new partitions did not appear."
    [[ $FIRMWARE == UEFI ]] && ESP_PART=${newparts[0]}
    ROOT_PART=${newparts[1]}
    if [[ $FIRMWARE == UEFI ]]; then
        mkfs.vfat -F32 -n IFOS_EFI "$ESP_PART" || die "Formatting the ESP failed."
    fi
    ;;

  alongside)
    info "Creating a partition in free space (${FREE_START} MiB → ${FREE_END} MiB)…"
    before=$(snapshot_parts)
    sgdisk -n "0:${FREE_START}M:$((FREE_END - 1))M" -t 0:8300 -c 0:"IFOS root" "$DISK" \
        || die "Could not create a partition in the free space."
    partprobe "$DISK"; udevadm settle; sleep 1
    ROOT_PART=$(comm -13 <(printf '%s\n' "$before") <(snapshot_parts) | head -1)
    [[ -b ${ROOT_PART:-} ]] || die "The new partition did not appear. Nothing was formatted."
    ok "Created $ROOT_PART — no other partition was modified"
    ;;

  partition)
    ROOT_PART=$TARGET_PART
    wipefs -af "$ROOT_PART" || die "Could not clear $ROOT_PART"
    ;;
esac

[[ -b ${ROOT_PART:-} ]] || die "No root partition determined — aborting before formatting."

info "Formatting $ROOT_PART as $FSTYPE…"
case $FSTYPE in
    ext4)  mkfs.ext4  -F -L IFOS "$ROOT_PART" || die "mkfs.ext4 failed." ;;
    btrfs) mkfs.btrfs -f -L IFOS "$ROOT_PART" || die "mkfs.btrfs failed." ;;
esac

info "Mounting…"
mount "$ROOT_PART" "$MNT" || die "Could not mount $ROOT_PART"
if [[ $FIRMWARE == UEFI ]]; then
    [[ -b ${ESP_PART:-} ]] || die "No EFI system partition available."
    mkdir -p "$MNT/boot/efi"
    mount "$ESP_PART" "$MNT/boot/efi" || die "Could not mount the EFI partition $ESP_PART"
    ok "Using EFI partition $ESP_PART (not reformatted)"
fi

info "Ranking mirrors…"
reflector --latest 20 --sort rate --protocol https --save /etc/pacman.d/mirrorlist 2>/dev/null \
    || warn "reflector failed; keeping the existing mirror list."

PACKAGES=(
    # ── base system ──────────────────────────────────────────────────────────
    base linux linux-firmware linux-headers mkinitcpio
    # A second kernel to fall back on when an update breaks the first one.
    linux-lts linux-lts-headers
    amd-ucode intel-ucode
    grub efibootmgr os-prober dosfstools
    e2fsprogs btrfs-progs exfatprogs ntfs-3g
    sudo man-db man-pages bash-completion pacman-contrib reflector
    git vim nano openssh rsync wget curl unzip zip 7zip unrar

    # ── networking ───────────────────────────────────────────────────────────
    networkmanager network-manager-applet nm-connection-editor wpa_supplicant
    ufw

    # ── audio and bluetooth ──────────────────────────────────────────────────
    pipewire pipewire-pulse pipewire-alsa pipewire-jack wireplumber
    pavucontrol pamixer playerctl brightnessctl
    bluez bluez-utils blueman

    # ── desktop ──────────────────────────────────────────────────────────────
    xorg-server xorg-xinit xorg-xrandr xorg-xsetroot xf86-input-libinput
    i3-wm i3lock xss-lock libnotify polybar rofi picom dunst feh
    xfce4-terminal alacritty xterm
    thunar thunar-volman thunar-archive-plugin gvfs gvfs-mtp gvfs-smb tumbler
    xarchiver mousepad gthumb
    # sddm-greeter links against Qt5, not qt6-declarative; without this the
    # ifos login theme's `import QtQuick.Controls 2.15` fails to resolve and
    # SDDM silently falls back to its stock theme.
    sddm qt5-quickcontrols2 polkit polkit-gnome plymouth
    xdg-user-dirs xdg-utils xdg-desktop-portal xdg-desktop-portal-gtk
    maim xclip xdotool arandr htop fastfetch dialog
    webkit2gtk-4.1 python-gobject adwaita-icon-theme adwaita-cursors

    # ── the applications a student actually needs on day one ─────────────────
    firefox firefox-i18n-pt-br
    libreoffice-fresh libreoffice-fresh-pt-br
    evince vlc mpv
    ffmpeg gst-plugins-good gst-plugins-bad gst-plugins-ugly gst-libav
    qalculate-gtk
    flatpak timeshift

    # ── printing and scanning ────────────────────────────────────────────────
    cups cups-pdf system-config-printer

    # ── fonts and theming ────────────────────────────────────────────────────
    ttf-jetbrains-mono-nerd noto-fonts noto-fonts-emoji noto-fonts-cjk
    noto-fonts-extra ttf-liberation otf-font-awesome
    adw-gtk-theme papirus-icon-theme qt5ct qt6ct kvantum

    # ── shell ────────────────────────────────────────────────────────────────
    fish
)

info "Installing the base system — this is the long part…"
pacstrap -K "$MNT" "${PACKAGES[@]}" || die "pacstrap failed. See $LOG"
ok "Packages installed"

info "Writing fstab…"
genfstab -U "$MNT" >>"$MNT/etc/fstab" || die "genfstab failed."

if (( SWAP_MIB > 0 )); then
    info "Creating a ${SWAP_MIB} MiB swap file…"
    if [[ $FSTYPE == btrfs ]]; then
        btrfs filesystem mkswapfile --size "${SWAP_MIB}m" "$MNT/swapfile" 2>/dev/null \
            || warn "Could not create a btrfs swap file; continuing without swap."
    else
        fallocate -l "${SWAP_MIB}M" "$MNT/swapfile" && chmod 600 "$MNT/swapfile" \
            && mkswap "$MNT/swapfile" >/dev/null \
            || warn "Could not create the swap file; continuing without swap."
    fi
    [[ -f $MNT/swapfile ]] && echo "/swapfile none swap defaults 0 0" >>"$MNT/etc/fstab"
fi

# IFOS identity goes in before the user is created, so useradd copies the IFOS
# /etc/skel rather than a vanilla one.
info "Applying IFOS branding and configuration…"
/usr/share/ifos/branding-sync.sh "$MNT" || warn "Branding sync reported a problem."

info "Configuring the installed system…"

# Console keymap -> X11 layout (br-abnt2 -> layout br, model abnt2)
XKB_LAYOUT=${KEYMAP%%-*}
XKB_MODEL=pc105
[[ $KEYMAP == *abnt2* ]] && XKB_MODEL=abnt2

# The answers are handed over in a file rather than interpolated into the
# script. Writing them inline would let a password containing $ or a backtick
# be expanded - or executed - by the shell that generates this.
{
    printf 'IFOS_TIMEZONE=%q\n'   "$TIMEZONE"
    printf 'IFOS_LOCALE=%q\n'     "$LOCALE"
    printf 'IFOS_KEYMAP=%q\n'     "$KEYMAP"
    printf 'IFOS_XKB_LAYOUT=%q\n' "$XKB_LAYOUT"
    printf 'IFOS_XKB_MODEL=%q\n'  "$XKB_MODEL"
    printf 'IFOS_HOSTNAME=%q\n'   "$HOSTNAME"
    printf 'IFOS_USERNAME=%q\n'   "$USERNAME"
    printf 'IFOS_USERPASS=%q\n'   "$USERPASS"
    printf 'IFOS_ROOTPASS=%q\n'   "$ROOTPASS"
    printf 'IFOS_DISK=%q\n'       "$DISK"
} > "$MNT/root/.ifos-answers"
chmod 600 "$MNT/root/.ifos-answers"

# Quoted delimiter: this heredoc is written out verbatim.
cat >"$MNT/root/ifos-configure.sh" <<'CHROOT'
#!/usr/bin/env bash
set -euo pipefail
. /root/.ifos-answers

ln -sf "/usr/share/zoneinfo/${IFOS_TIMEZONE}" /etc/localtime
hwclock --systohc || true

grep -q "^${IFOS_LOCALE}" /etc/locale.gen || echo "${IFOS_LOCALE} UTF-8" >> /etc/locale.gen
sed -i "s/^#${IFOS_LOCALE}/${IFOS_LOCALE}/" /etc/locale.gen
locale-gen
echo "LANG=${IFOS_LOCALE}" > /etc/locale.conf
echo "KEYMAP=${IFOS_KEYMAP}" > /etc/vconsole.conf

mkdir -p /etc/X11/xorg.conf.d
cat > /etc/X11/xorg.conf.d/00-keyboard.conf <<XKB
Section "InputClass"
    Identifier "system-keyboard"
    MatchIsKeyboard "on"
    Option "XkbLayout" "${IFOS_XKB_LAYOUT}"
    Option "XkbModel" "${IFOS_XKB_MODEL}"
EndSection
XKB

echo "${IFOS_HOSTNAME}" > /etc/hostname
cat > /etc/hosts <<HOSTS
127.0.0.1   localhost
::1         localhost
127.0.1.1   ${IFOS_HOSTNAME}.localdomain ${IFOS_HOSTNAME}
HOSTS

mkdir -p /etc/mkinitcpio.conf.d
cat > /etc/mkinitcpio.conf.d/ifos.conf <<'MKI'
HOOKS=(base udev plymouth autodetect microcode modconf kms keyboard keymap consolefont block filesystems fsck)
MKI
mkinitcpio -P

useradd -m -G wheel,audio,video,input,storage,network,lp -s /usr/bin/fish "${IFOS_USERNAME}"
echo "${IFOS_USERNAME}:${IFOS_USERPASS}" | chpasswd
if [ -n "${IFOS_ROOTPASS}" ]; then
    echo "root:${IFOS_ROOTPASS}" | chpasswd
else
    passwd -l root
fi

install -d -m 750 /etc/sudoers.d
echo '%wheel ALL=(ALL:ALL) ALL' > /etc/sudoers.d/10-wheel
chmod 440 /etc/sudoers.d/10-wheel

systemctl enable NetworkManager.service
systemctl enable bluetooth.service
systemctl enable sddm.service
systemctl enable systemd-timesyncd.service
systemctl enable fstrim.timer
systemctl enable cups.service
systemctl enable ufw.service
systemctl enable paccache.timer
ufw default deny incoming  || true
ufw default allow outgoing || true
ufw --force enable         || true

if [ -d /sys/firmware/efi/efivars ]; then
    grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=IFOS
else
    grub-install --target=i386-pc "${IFOS_DISK}"
fi
sed -i 's/^#\?GRUB_DISABLE_OS_PROBER=.*/GRUB_DISABLE_OS_PROBER=false/' /etc/default/grub
grep -q '^GRUB_DISABLE_OS_PROBER' /etc/default/grub || echo 'GRUB_DISABLE_OS_PROBER=false' >> /etc/default/grub
sed -i 's/^GRUB_CMDLINE_LINUX_DEFAULT=.*/GRUB_CMDLINE_LINUX_DEFAULT="loglevel=3 quiet splash"/' /etc/default/grub
sed -i 's/^GRUB_DISTRIBUTOR=.*/GRUB_DISTRIBUTOR="IFOS"/' /etc/default/grub
grep -q '^GRUB_DISTRIBUTOR' /etc/default/grub || echo 'GRUB_DISTRIBUTOR="IFOS"' >> /etc/default/grub

# The IFOS boot menu. gfxterm is what makes a theme render at all; without an
# explicit GFXMODE some firmware drops to 640x480 and the theme looks cramped.
if [ -f /usr/share/grub/themes/ifos/theme.txt ]; then
    sed -i '/^GRUB_THEME=/d; /^GRUB_GFXMODE=/d; /^GRUB_TERMINAL_OUTPUT=/d; /^GRUB_GFXPAYLOAD_LINUX=/d' /etc/default/grub
    {
        echo 'GRUB_THEME="/usr/share/grub/themes/ifos/theme.txt"'
        echo 'GRUB_GFXMODE="1920x1080,1366x768,auto"'
        echo 'GRUB_GFXPAYLOAD_LINUX="keep"'
        echo 'GRUB_TERMINAL_OUTPUT="gfxterm"'
    } >> /etc/default/grub
fi
grub-mkconfig -o /boot/grub/grub.cfg

cp -rn /etc/skel/. "/home/${IFOS_USERNAME}/" 2>/dev/null || true
chown -R "${IFOS_USERNAME}:${IFOS_USERNAME}" "/home/${IFOS_USERNAME}"
CHROOT

chmod +x "$MNT/root/ifos-configure.sh"
arch-chroot "$MNT" /root/ifos-configure.sh || die "Configuring the new system failed. See $LOG"
rm -f "$MNT/root/ifos-configure.sh" "$MNT/root/.ifos-answers"

# The live medium autologins; a real installation must not.
rm -f "$MNT/etc/sudoers.d/10-ifos-live"
[[ -f $MNT/etc/sddm.conf.d/ifos.conf ]] && \
    sed -i '/^\[Autologin\]/,/^\[/{/^User=/d;/^Session=/d}' "$MNT/etc/sddm.conf.d/ifos.conf"

sync
ok "Installation complete"

cat <<EOF

${c_grn}  IFOS is installed.${c_reset}

    Log in as       ${c_b}$USERNAME${c_reset}
    Other systems   $( [[ $MODE == wipe ]] && echo 'none — the disk was erased' || echo 'kept; GRUB was told to detect them' )
    Install log     $LOG

    After the first boot press ${c_b}Mod+Shift+A${c_reset} (or run ${c_b}ifos-software${c_reset})
    to install a browser, games, drivers and anything else you want.

EOF

read -rp "  Reboot into IFOS now? [y/N] " r
if [[ ${r,,} == y* ]]; then
    umount -R "$MNT" 2>/dev/null
    systemctl reboot
fi
