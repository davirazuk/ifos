def command_exists(command: str) -> bool:
    """Is the first word of this shell command something that can be run?

    The Sistema section is a fixed list, and it was drawn in full whether or
    not the machine had the program behind each tile. On an install without
    arandr the "Monitores" tile did nothing; without xfce4-terminal, so did
    "Terminal". A tile that cannot work is worse than a missing one - it reads
    as the system being broken rather than as the program not being there.
    """
    words = shlex.split(command) or [""]
    first = words[0]
    if first == "sudo" and len(words) > 1:
        first = words[1]
    if first.startswith(("~", "/", ".")):
        return os.access(os.path.expanduser(first), os.X_OK)
    return shutil.which(first) is not None


def sh(cmd: list[str]) -> str:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=20).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


# ── data ─────────────────────────────────────────────────────────────────────
class Catalog:
    def __init__(self) -> None:
        self.installed_pkgs = {
            line.strip() for line in sh(["pacman", "-Qq"]).splitlines() if line.strip()
        }
        self.flatpaks = {
            line.split()[0]
            for line in sh(["flatpak", "list", "--app", "--columns=application"]).splitlines()
            if line.strip()
        }
        self.appinfos = [a for a in Gio.AppInfo.get_all() if a.should_show()]
        self.sections: list[tuple[str, str, list[dict]]] = []   # (key, title, entries)
        self._load_catalog()
        self._reconcile_with_desktop()
        self._add_installed_games()
        self._add_all_apps()
        self._add_system()
        self._add_recent()

    # what this account actually opens ----------------------------------------
    @staticmethod
    def entry_key(entry: dict) -> str | None:
        """A stable name for an entry, or None for things not worth recording.

        System actions are deliberately excluded: "Bloquear tela" and "Desligar"
        would otherwise crowd out the applications, and nobody needs a shortcut
        to the thing they just used to shut the machine down.
        """
        if entry.get("kind") == "app":
            info = entry.get("appinfo")
            ident = info.get_id() if info is not None else None
            return "app:" + (ident or entry["name"])
        if entry.get("kind") == "package":
            return "pkg:" + entry["name"]
        return None

    @staticmethod
    def _read_recent() -> list[str]:
        try:
            with open(RECENT_FILE, encoding="utf-8") as handle:
                return [line.strip() for line in handle if line.strip()]
        except OSError:
            return []

    def remember(self, entry: dict) -> None:
        key = self.entry_key(entry)
        if key is None:
            return
        keys = [k for k in self._read_recent() if k != key]
        keys.insert(0, key)
        del keys[RECENT_MAX:]
        try:
            os.makedirs(os.path.dirname(RECENT_FILE), exist_ok=True)
            # Written through a temporary file so that a launcher killed
            # mid-write cannot leave a half-written history behind.
            tmp = RECENT_FILE + ".new"
            with open(tmp, "w", encoding="utf-8") as handle:
                handle.write("\n".join(keys) + "\n")
            os.replace(tmp, RECENT_FILE)
        except OSError:
            pass          # a history that cannot be saved is not worth an error

    def _add_recent(self) -> None:
        keys = self._read_recent()
        if not keys:
            return

        # Resolve against what exists now, so an application that has since been
        # uninstalled simply drops off the list instead of showing a tile that
        # cannot start.
        known: dict[str, dict] = {}
        for _key, _title, entries in self.sections:
            for entry in entries:
                ident = self.entry_key(entry)
                if ident is not None:
                    known.setdefault(ident, entry)

        recent = [known[k] for k in keys if k in known and known[k]["installed"]]
        if recent:
            # First, so the launcher opens on what you actually use.
            self.sections.insert(0, ("recentes", "Recentes", recent))

    # catalog files -----------------------------------------------------------
    def _load_catalog(self) -> None:
        if not os.path.isdir(CATALOG_DIR):
            return
        for filename in sorted(os.listdir(CATALOG_DIR)):
            if not filename.endswith(".list"):
                continue
            stem = re.sub(r"^\d+-", "", filename[: -len(".list")])
            entries = []
            with open(os.path.join(CATALOG_DIR, filename), encoding="utf-8") as handle:
                for line in handle:
                    line = line.strip()
                    if not line or line.startswith("#"):
                        continue
                    parts = line.split("|")
                    if len(parts) < 3:
                        continue
                    packages = parts[2].split()
                    source = parts[3].strip() if len(parts) > 3 else "repo"
                    entries.append(
                        {
                            "kind": "package",
                            "name": parts[0].strip(),
                            "desc": parts[1].strip(),
                            "packages": packages,
                            "source": source,
                            "category": stem,
                            "installed": self._is_installed(packages, source),
                        }
                    )
            if entries:
                self.sections.append((stem, SECTION_TITLES.get(stem, stem.capitalize()), entries))

    def refresh_installed(self) -> None:
        """Re-ask what is installed, after something has been installed."""
        self.installed_pkgs = {
            line.strip() for line in sh(["pacman", "-Qq"]).splitlines() if line.strip()
        }
        self.flatpaks = {
            line.split()[0]
            for line in sh(["flatpak", "list", "--app", "--columns=application"]).splitlines()
            if line.strip()
        }
        for _key, _title, entries in self.sections:
            for entry in entries:
                if entry.get("kind") == "package":
                    entry["installed"] = self._is_installed(
                        entry["packages"], entry.get("source", "repo")
                    )
        # A fresh install may well have landed a desktop entry rather than a
        # package pacman recognises by the catalog's name, so ask again the same
        # way the first pass did.
        self.appinfos = [a for a in Gio.AppInfo.get_all() if a.should_show()]
        self._reconcile_with_desktop()

    def _is_installed(self, packages: list[str], source: str) -> bool:
        if source == "flatpak":
            return all(p in self.flatpaks for p in packages)
        return all(p in self.installed_pkgs for p in packages)

    def _add_installed_games(self) -> None:
        """Put the games that are on the machine at the top of Jogos.

        The section was a shop: Steam, Lutris, Heroic, Wine, and no way to
        reach a game from it. Every installed game is somewhere in "Todos",
        between LibreOffice Calc and the printer settings, which is the one
        place nobody looks for one - and in the Big Picture session, which
        opens here and is meant to work from a sofa with a gamepad, it was the
        difference between a console and a catalogue.

        A game says so itself: the desktop-entry spec has a Game category, and
        Steam, Lutris and Heroic all write it into the shortcuts they generate.
        So this is not a list anybody has to maintain - it is whatever the
        machine has, asked directly.
        """
        for index, (key, title, entries) in enumerate(self.sections):
            if key != "gaming":
                continue

            # Not the storefronts. Steam is already in this section as a tile
            # that says PRONTO, and a second one two places along - same name,
            # same icon, different tile - reads as a fault.
            known = {e["name"].strip().lower() for e in entries}

            games = []
            for info in sorted(self.appinfos,
                               key=lambda a: (a.get_display_name() or "").lower()):
                categories = (info.get_categories() or "").lower().split(";")
                if "game" not in categories:
                    continue
                name = (info.get_display_name() or info.get_name() or "").strip()
                if not name or name.lower() in known:
                    continue
                known.add(name.lower())
                games.append({
                    "kind": "app",
                    "name": name,
                    "desc": info.get_description() or "",
                    "appinfo": info,
                    "category": "gaming",
                    "installed": True,
                })

            if games:
                self.sections[index] = (key, title, games + entries)
            return

    # everything with a .desktop file, so nothing is unreachable ---------------
    def _add_all_apps(self) -> None:
        entries = []
        for info in sorted(self.appinfos, key=lambda a: (a.get_display_name() or "").lower()):
            name = info.get_display_name() or info.get_name() or ""
            if not name:
                continue
            entries.append(
                {
                    "kind": "app",
                    "name": name,
                    "desc": info.get_description() or "",
                    "appinfo": info,
                    "category": "todos",
                    "installed": True,
                }
            )
        if entries:
            self.sections.append(("todos", "Todos", entries))

    def _add_system(self) -> None:
        entries = [
            ("IFOS Software", "Instalar programas, jogos e drivers",
             "system-software-install", "ifos-software", True),
            # Updating was a command nobody could discover: the only way to
            # reach it was to already know the words "ifos-update". It runs in
            # a terminal because it asks questions, reports what it is doing,
            # and ends with a cancellable countdown before the restart - none
            # of which survives being run silently in the background.
            ("Atualizar o IFOS", "Buscar as novidades e atualizar tudo",
             "system-software-update", "ifos-update-terminal",
             not os.path.isdir("/run/archiso")),
            ("Instalar o IFOS", "Instalar o sistema neste computador",
             "drive-harddisk", "sudo install-ifos", os.path.isdir("/run/archiso")),
            ("Tema", "Alternar entre o tema IFMS e o Catppuccin",
             "preferences-desktop-theme", "ifos-theme toggle", True),
            ("Rede", "Configurar Wi-Fi e conexões",
             "network-wireless", "nm-connection-editor", True),
            ("Áudio", "Volume e dispositivos de som",
             "audio-volume-high", "pavucontrol", True),
            # Graphics is the one part of the machine that breaks in a way
            # nothing on screen explains: the driver goes missing after an
            # update, X quietly falls back to drawing on the processor, and the
            # only symptom is that everything is slow and Steam refuses to open
            # with a message about libGL. Diagnosing that took lsmod, modinfo
            # and glxinfo. Now it takes clicking this.
            ("Vídeo e jogos", "Verificar e consertar os drivers da placa de vídeo",
             "video-display", "ifos-term 'Vídeo e jogos' ifos-gpu --fix", True),
            # "O controle não funciona" is three different problems that look
            # identical from the sofa: no driver, no access to /dev/hidraw so
            # there is no rumble and the buttons are named wrong, or a
            # Bluetooth pad nobody knows the pairing combination for.
            ("Controles", "Ver os controles ligados e como parear",
             "input-gaming",
             "ifos-term 'Controles' ifos-controller", True),
            # The DPI button on a gaming mouse is handled inside the mouse and
            # sends nothing to the computer, so there is nothing here to bind
            # and no way for the system to say it was pressed. This is where
            # the sensitivity actually lives, plus a test that settles whether
            # the button emits anything at all.
            ("Mouse", "Velocidade, aceleração e o que cada botão faz",
             "input-mouse", "ifos-term 'Mouse' ifos-mouse", True),
            ("Monitores", "Resolução e disposição das telas",
             "video-display", "arandr", True),
            # Everything added for screens so far was a keyboard shortcut, and
            # a shortcut is only useful to somebody who has been told about it.
            # A student who plugs in a projector and sees nothing happen is not
            # going to try Mod+P; they are going to look for something to click.
            ("Detectar telas", "Reconhecer um projetor ou monitor recém-ligado",
             "video-joined-displays", "~/.config/i3/scripts/screens.sh", True),
            ("Melhor resolução", "Usar a maior resolução que o monitor aceita",
             "preferences-desktop-display",
             "~/.config/i3/scripts/screens.sh --use-best", True),
            ("Atalhos do teclado", "A lista completa de atalhos do IFOS",
             "preferences-desktop-keyboard-shortcuts",
             "ifos-term 'Atalhos do teclado' "
             "cat /usr/share/ifos/keybindings.txt", True),
            ("Arquivos", "Gerenciador de arquivos",
             "system-file-manager", "thunar", True),
            ("Terminal", "Linha de comando",
             "utilities-terminal", "xfce4-terminal", True),
            ("Bloquear tela", "Trancar a sessão",
             "system-lock-screen", "ifos-lock", True),
            ("Reiniciar", "Reiniciar o computador",
             "system-reboot", "systemctl reboot", True),
            ("Desligar", "Desligar o computador",
             "system-shutdown", "systemctl poweroff", True),
        ]
        items = [
            {
                "kind": "action",
                "name": name,
                "desc": desc,
                "icon": icon,
                "command": command,
                "category": "sistema",
                "installed": True,
            }
            for name, desc, icon, command, show in entries
            if show and command_exists(command)
        ]
        self.sections.append(("sistema", "Sistema", items))

    # ── making the list agree with the machine ───────────────────────────────
    def _reconcile_with_desktop(self) -> None:
        """Mark catalog entries whose program is demonstrably already here.

        "Installed" was decided purely by asking pacman whether it owned every
        package on the line. That is right for the common case and wrong every
        time a program arrived by another road: Steam as a Flatpak, VS Code
        built from the AUR under a different package name, anything installed
        before IFOS was. Those all sat in the catalog offering to install
        something the machine already had, and clicking the tile started a
        download instead of the program - which is the launcher disagreeing
        with the system in the most visible way it can.

        Only ever turns "missing" into "present", and only on evidence: a
        binary on PATH, or a desktop entry by that name. Nothing here can hide
        something that really is not installed.
        """
        by_name = {
            (info.get_display_name() or "").strip().lower()
            for info in self.appinfos
        }
        for _key, _title, entries in self.sections:
            for entry in entries:
                if entry.get("kind") != "package" or entry["installed"]:
                    continue
                packages = entry.get("packages", [])
                # One package, one program: a binary by that name is proof.
                # Multi-package entries are kits - "Kit Redes" is nine tools -
                # and one of the nine being present says nothing about the rest.
                if len(packages) == 1 and shutil.which(packages[0]):
                    entry["installed"] = True
                elif entry["name"].strip().lower() in by_name:
                    entry["installed"] = True

    # matching ---------------------------------------------------------------
    @staticmethod
    def _is_the_program(info) -> bool:
        """True when this entry *is* its program, not something that runs it.

        Steam writes a .desktop file per installed game, and every one of them
        has `Exec=steam steam://rungameid/<id>`. Their executable is therefore
        "steam", exactly like Steam's own entry - so matching a catalog item to
        a desktop file by executable name matched whichever of them
        Gio.AppInfo.get_all() happened to return first. On a machine with games
        installed that is a game: the Steam tile drew Hollow Knight's icon, and
        clicking it ran `steam steam://rungameid/367520`, which starts Steam and
        then launches Hollow Knight - which is also why Steam appeared to take
        forever to open and then not be Steam.

        The distinguishing feature is the argument. `steam %U` takes whatever
        you give it; `steam steam://rungameid/367520` has a target baked in.
        Anything left after dropping the binary, the desktop-entry field codes
        and the options means this entry launches something specific.
        """
        line = info.get_commandline() or ""
        try:
            tokens = shlex.split(line)
        except ValueError:
            tokens = line.split()
        for token in tokens[1:]:
            if re.fullmatch(r"%[a-zA-Z]", token) or token.startswith("-"):
                continue
            return False
        return True

    def find_appinfo(self, entry: dict):
        if entry.get("kind") == "app":
            return entry["appinfo"]
        wanted = {p.lower() for p in entry.get("packages", [])}
        wanted.add(entry["name"].split()[0].lower())

        # Ordered, most specific first. The desktop id is the only one of these
        # that is unique, so it is asked before anything that several entries
        # can answer to.
        for info in self.appinfos:
            ident = (info.get_id() or "").lower().removesuffix(".desktop")
            if ident in wanted:
                return info

        target = entry["name"].lower()
        for info in self.appinfos:
            if (info.get_display_name() or "").lower() == target:
                return info

        for info in self.appinfos:
            executable = os.path.basename(info.get_executable() or "").lower()
            if executable in wanted and self._is_the_program(info):
                return info
        return None


def load_school_links() -> list[tuple[str, str, str]]:
    links = []
    if os.path.exists(SCHOOL_LIST):
        with open(SCHOOL_LIST, encoding="utf-8") as handle:
            for line in handle:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                parts = line.split("|")
                if len(parts) >= 2:
                    links.append(
                        (parts[0].strip(), parts[1].strip(),
                         parts[2].strip() if len(parts) > 2 else "")
                    )
    if not links:
        links = [("Moodle (AVEA)", "https://ead.ifms.edu.br/", "")]
    return links


# ── the window ───────────────────────────────────────────────────────────────
class Launcher(Gtk.Window):
    def __init__(self, catalog: Catalog, start: str | None, use_gamepad: bool) -> None:
        super().__init__(title="IFOS")
        self.catalog = catalog
        self.school_links = load_school_links()
        self.section_index = 0
        self.tab_keys: list[str] = []
        self.tab_titles: list[str] = []
        self._needle = ""
        self._searching = False        # showing every section at once
        # Checked once: lspci is cheap but not free, and the answer
        # cannot change while the launcher is open.
        # Not asked here. `ifos-gpu --has-dgpu` shells out to lspci, and this
        # ran before the window was mapped with a five second timeout - so on a
        # machine where lspci was slow the launcher showed nothing at all for
        # up to five seconds. In the Big Picture session the launcher is the
        # session, which makes that a black screen at boot. The answer is only
        # needed when a game is actually started, by which time the interface
        # is up; None means "not asked yet".
        self._offload_gpu: bool | None = None
        self._suppress_search = False  # while a tab change resets the box

        display = Gdk.Display.get_default()
        if display is not None and display.get_n_monitors() > 0:
            geometry = display.get_monitor(0).get_geometry()
            self.set_default_size(geometry.width, geometry.height)
        else:
            self.set_default_size(1366, 768)
        self.fullscreen()
        self.connect("destroy", Gtk.main_quit)
        self.connect("key-press-event", self.on_key)

        settings = Gtk.Settings.get_default()
        if settings is not None:
            theme = Gtk.IconTheme.get_default()
            current = settings.get_property("gtk-icon-theme-name") or ""
            if not theme.has_icon("applications-education"):
                for candidate in ("Papirus-Dark", "Papirus", "Adwaita", "hicolor"):
                    settings.set_property("gtk-icon-theme-name", candidate)
                    if Gtk.IconTheme.get_default().has_icon("applications-education"):
                        break
                else:
                    settings.set_property("gtk-icon-theme-name", current or "Adwaita")

        css = CSS_TEMPLATE % {"wallpaper": WALLPAPER if os.path.exists(WALLPAPER) else ""}
        provider = Gtk.CssProvider()
        provider.load_from_data(css.encode())
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION
        )

        backdrop = Gtk.Box()
        backdrop.get_style_context().add_class("backdrop")
        self.add(backdrop)

        # Sidebar on the left, everything else in a column beside it.
        scrim = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        scrim.get_style_context().add_class("scrim")
        backdrop.pack_start(scrim, True, True, 0)

        scrim.pack_start(self._build_nav(), False, False, 0)

        content = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        content.get_style_context().add_class("content")
        scrim.pack_start(content, True, True, 0)

        content.pack_start(self._build_topbar(), False, False, 0)

        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        self.stack.set_transition_duration(140)
        content.pack_start(self.stack, True, True, 0)

        self.stack.add_named(self._build_apps_page(), "apps")
        self.stack.add_named(self._build_school_page(), "escola-online")

        content.pack_start(self._build_footer(), False, False, 0)

        # Section 0 is whatever the catalog put first; honour --category.
        if start:
            index = self.section_for(start, self.tab_keys, self.tab_titles)
            if index is not None:
                self.section_index = index

        # Shown before the section is picked, and this order matters: GtkStack
        # will not make a child that is not itself visible into the visible
        # child, so selecting a page here while everything was still unshown
        # did nothing and the stack kept its first page. --category therefore
        # always landed on the apps grid - including `ifos-launcher --category
        # escola-online`, which is what the `moodle` command runs, so asking
        # for Moodle opened the application list instead.
        self.show_all()
        self.select_tab(self.section_index)

        GLib.timeout_add_seconds(10, self._tick_clock)
        if use_gamepad:
            self.attach_gamepad()

    # navigation --------------------------------------------------------------
    #  Sections live down the side rather than in a strip across the top. The
    #  strip was a horizontal scroller: with a dozen sections the later ones sat
    #  off the edge, reachable only by scrolling something that did not look
    #  scrollable, and the names were the only thing distinguishing them.
    #  Down the side they all fit, they carry the icons the catalog already
    #  names, and the reading order matches the tiles.
    def _build_nav(self) -> Gtk.Widget:
        nav = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        nav.get_style_context().add_class("nav")
        nav.set_size_request(228, -1)

        brand = Gtk.Label(label="IFOS", xalign=0)
        brand.get_style_context().add_class("brand")
        nav.pack_start(brand, False, False, 0)
        subtitle = Gtk.Label(label="IFMS · CAMPUS DOURADOS", xalign=0)
        subtitle.get_style_context().add_class("subtitle")
        nav.pack_start(subtitle, False, False, 0)

        items = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        items.get_style_context().add_class("navitems")
        self.tab_buttons = []
        self.tab_titles = []

        def add_tab(key: str, label: str) -> None:
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            icon = Gtk.Image.new_from_icon_name(
                section_icon(key), Gtk.IconSize.LARGE_TOOLBAR
            )
            icon.set_pixel_size(20)
            row.pack_start(icon, False, False, 0)
            row.pack_start(Gtk.Label(label=label, xalign=0), True, True, 0)

            button = Gtk.Button()
            button.add(row)
            button.get_style_context().add_class("navitem")
            button.set_relief(Gtk.ReliefStyle.NONE)
            button.set_can_focus(False)
            index = len(self.tab_keys)
            button.connect("clicked", lambda _b, i=index: self.select_tab(i))
            items.pack_start(button, False, False, 0)
            self.tab_buttons.append(button)
            self.tab_keys.append(key)
            self.tab_titles.append(label)

        # Escola Online sits right after Escola: school first, by design.
        for key, title, _ in self.catalog.sections:
            add_tab(key, title)
            if key == "escola":
                add_tab("escola-online", "Escola Online")
        if "escola-online" not in self.tab_keys:
            add_tab("escola-online", "Escola Online")

        # More sections than fit is a real possibility once a fork adds its own,
        # so the list scrolls rather than pushing the clock off the bottom.
        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        scroller.add(items)
        nav.pack_start(scroller, True, True, 0)

        clocks = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        clocks.get_style_context().add_class("clocks")
        self.clock = Gtk.Label(xalign=0)
        self.clock.get_style_context().add_class("clock")
        clocks.pack_start(self.clock, False, False, 0)
        self.clockdate = Gtk.Label(xalign=0)
        self.clockdate.get_style_context().add_class("clockdate")
        clocks.pack_start(self.clockdate, False, False, 0)
        nav.pack_end(clocks, False, False, 0)

        self._tick_clock()
        return nav

    def _build_topbar(self) -> Gtk.Widget:
        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        top.get_style_context().add_class("topbar")

        # The section you are in, named where you are looking rather than only
        # highlighted in the corner of your eye.
        self.section_label = Gtk.Label(xalign=0)
        self.section_label.get_style_context().add_class("sectiontitle")
        top.pack_start(self.section_label, True, True, 0)

        # 120 entries is too many to hunt through by eye.
        self.search = Gtk.SearchEntry()
        self.search.set_placeholder_text("Procurar em tudo…")
        self.search.set_size_request(320, 36)
        self.search.set_valign(Gtk.Align.CENTER)
        self.search.get_style_context().add_class("search")
        self.search.connect("search-changed", self._on_search)
        self.search.connect("activate", self._on_search_activate)
        top.pack_end(self.search, False, False, 0)
        return top

    def _tick_clock(self) -> bool:
        now = datetime.now()
        self.clock.set_text(now.strftime("%H:%M"))
        try:
            # Uppercase the first letter and leave the rest alone. str.capitalize
            # lowercases everything after it, which is invisible in Portuguese -
            # "domingo, 02 de agosto" is lowercase to begin with - and mangles
            # every locale where a month name is capitalised: an account left on
            # English read "Sunday, 02 de august".
            stamp = now.strftime("%A, %d de %B")
            self.clockdate.set_text(stamp[:1].upper() + stamp[1:])
        except ValueError:
            self.clockdate.set_text(now.strftime("%d/%m/%Y"))
        return True

    def _build_footer(self) -> Gtk.Widget:
        footer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        footer.get_style_context().add_class("footer")
        self.hint = Gtk.Label(
            label="↑↓←→ navegar    Enter abrir    digite para procurar    Tab trocar de seção    Esc sair",
            xalign=0,
        )
        self.hint.get_style_context().add_class("hint")
        footer.pack_start(self.hint, True, True, 0)
        return footer

    # apps page --------------------------------------------------------------
    def _build_apps_page(self) -> Gtk.Widget:
        scroller = Gtk.ScrolledWindow()
        scroller.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.flow = Gtk.FlowBox()
        self.flow.set_valign(Gtk.Align.START)
        self.flow.set_max_children_per_line(7)
        self.flow.set_min_children_per_line(2)
        self.flow.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.flow.set_row_spacing(16)
        self.flow.set_column_spacing(16)
        self.flow.set_margin_top(10)
        self.flow.set_margin_bottom(24)
        self.flow.set_margin_start(34)
        self.flow.set_margin_end(34)
        self.flow.set_homogeneous(True)
        self.flow.connect("child-activated", self.on_activate)
        self.flow.set_filter_func(self._filter_tile)
        scroller.add(self.flow)

        # A search that matches nothing used to leave a blank green page with
        # no explanation - indistinguishable from the launcher having hung, and
        # the reason people typed the same thing again instead of trying
        # another word.
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.no_results = Gtk.Label(xalign=0.5)
        self.no_results.get_style_context().add_class("empty")
        self.no_results.set_justify(Gtk.Justification.CENTER)
        self.no_results.set_no_show_all(True)
        self.no_results.set_margin_top(80)
        page.pack_start(self.no_results, False, False, 0)
        page.pack_start(scroller, True, True, 0)
        self.flow_scroller = scroller
        return page

    def _update_no_results(self) -> None:
        """Show the message, and hide the grid while it is up.

        Leaving the empty FlowBox in place is not the same as it being
        invisible: it still lays out its rows, so the message appeared over a
        set of empty horizontal bands.
        """
        found = not self._needle or any(
            c.get_child_visible() for c in self.flow.get_children()
        )
        if found:
            self.no_results.hide()
            self.flow_scroller.show()
            return
        self.no_results.set_text(
            "Nada encontrado para “%s”.\n\n"
            "Tente outra palavra: o nome do programa, para que ele serve,\n"
            "ou o nome que ele tinha no Windows." % self.search.get_text().strip()
        )
        self.no_results.show()
        self.flow_scroller.hide()

    def _filter_tile(self, child) -> bool:
        needle = getattr(self, "_needle", "")
        if not needle:
            return True
        entry = getattr(child.get_child(), "entry", None)
        if entry is None:
            return True
        return all(word in self._haystack(entry) for word in fold(needle).split())

    def _haystack(self, entry: dict) -> str:
        """Everything a tile can be found by, folded and cached.

        Cached on the entry: the filter runs once per tile per keystroke, and
        typing "libreoffice" across 169 tiles rebuilt and re-folded the same
        strings a couple of thousand times.
        """
        cached = entry.get("_haystack")
        if cached is not None:
            return cached
        parts = [entry["name"], entry.get("desc", "")]
        parts += entry.get("packages", [])
        # The section, so "jogos" finds the games rather than only the tile
        # whose description happens to contain the word.
        category = entry.get("category", "")
        parts += [category, SECTION_TITLES.get(category, "")]
        # Folded on both sides: the catalog calls them "Impressão" and
        # "Digitalização", and a table keyed on the raw lowercase name would
        # never match those.
        parts.append(SEARCH_ALIASES.get(fold(entry["name"]), ""))
        text = fold(" ".join(p for p in parts if p))
        entry["_haystack"] = text
        return text

    def populate_all(self) -> None:
        """Every entry on the machine, for searching across sections."""
        for child in self.flow.get_children():
            self.flow.remove(child)

        seen: set[str] = set()
        for _key, _title, entries in self.catalog.sections:
            for entry in entries:
                ident = self.catalog.entry_key(entry) or ("act:" + entry["name"])
                if ident in seen:
                    continue
                seen.add(ident)
                self.flow.add(self._make_tile(entry))
        self.flow.show_all()

    def _on_search(self, entry) -> None:
        self._needle = fold(entry.get_text().strip())

        # Searching looks at the whole machine, not the section that happens to
        # be open. The flow only ever held one section, so typing "gimp" while
        # on Recentes searched the dozen things in Recentes and found nothing -
        # and the footer has always said "digite para procurar" without saying
        # "nesta seção". Opening on Recentes made that much easier to hit.
        if not self._suppress_search:
            if self._needle and not self._searching:
                self._searching = True
                self.populate_all()
                # The heading has to follow, or the grid says every application
                # on the machine while the title above it still says "Recentes".
                self.section_label.set_text("Resultados")
            elif not self._needle and self._searching:
                self._searching = False
                self.populate(self.tab_keys[self.section_index])
                self.section_label.set_text(self.tab_titles[self.section_index])

        self.flow.invalidate_filter()
        # Keep something selected so Enter always has a target.
        for child in self.flow.get_children():
            if child.get_child_visible() and child.get_mapped():
                self.flow.select_child(child)
                break
        self._update_no_results()

    def _on_search_activate(self, _entry) -> None:
        visible = [c for c in self.flow.get_children() if c.get_mapped()]
        if visible:
            self.flow.select_child(visible[0])
            self.on_activate(self.flow, visible[0])

    def _icon_for(self, entry: dict, info) -> Gtk.Image:
        if entry.get("kind") == "action":
            image = Gtk.Image.new_from_icon_name(entry["icon"], Gtk.IconSize.DIALOG)
            image.set_pixel_size(56)
            return image
        if info is not None:
            gicon = info.get_icon()
            if gicon is not None:
                image = Gtk.Image.new_from_gicon(gicon, Gtk.IconSize.DIALOG)
                image.set_pixel_size(56)
                return image
        theme = Gtk.IconTheme.get_default()
        candidates = list(entry.get("packages", []))
        candidates.append(entry["name"].split()[0].lower())
        candidates.append(re.sub(r"[^a-z0-9]+", "-", entry["name"].lower()).strip("-"))
        for name in candidates:
            if name and theme.has_icon(name):
                image = Gtk.Image.new_from_icon_name(name, Gtk.IconSize.DIALOG)
                image.set_pixel_size(56)
                return image
        image = Gtk.Image.new_from_icon_name(
            section_icon(entry.get("category", "")), Gtk.IconSize.DIALOG
        )
        image.set_pixel_size(56)
        return image

    def _make_tile(self, entry: dict) -> Gtk.Widget:
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
        box.get_style_context().add_class("tile")

        info = self.catalog.find_appinfo(entry) if entry["installed"] else None
        box.pack_start(self._icon_for(entry, info), False, False, 0)

        name = Gtk.Label(label=entry["name"])
        name.get_style_context().add_class("tile-name")
        name.set_line_wrap(True)
        # Break between words, never inside one. The default also breaks at any
        # character when a word does not fit, and the names this list is full of
        # are exactly the ones that suffer for it: "Compiladores C/C++" came out
        # as "Compiladores C/C+" over "+", which reads as a typo rather than as
        # a wrap. Anything genuinely too long is ellipsised two lines down.
        name.set_line_wrap_mode(Pango.WrapMode.WORD)
        name.set_justify(Gtk.Justification.CENTER)
        name.set_max_width_chars(16)
        name.set_lines(2)
        name.set_ellipsize(Pango.EllipsizeMode.END)
        box.pack_start(name, False, False, 0)

        if entry["desc"]:
            desc = Gtk.Label(label=entry["desc"])
            desc.get_style_context().add_class("tile-desc")
            desc.set_line_wrap(True)
            desc.set_justify(Gtk.Justification.CENTER)
            desc.set_max_width_chars(22)
            desc.set_lines(2)
            desc.set_ellipsize(Pango.EllipsizeMode.END)
            box.pack_start(desc, False, False, 0)

        if entry.get("kind") == "package":
            badge = Gtk.Label(label="PRONTO" if entry["installed"] else "INSTALAR")
            badge.get_style_context().add_class(
                "badge-ready" if entry["installed"] else "badge-install"
            )
            # pack_end, not pack_start. A FlowBox row is as tall as its tallest
            # tile, and packing from the top left every badge at whatever height
            # its own name and description happened to end at - a row of
            # INSTALAR at four different heights. From the bottom they line up.
            box.pack_end(badge, False, False, 0)

        box.entry = entry
        box.appinfo = info
        return box

    def populate(self, key: str) -> None:
        for child in self.flow.get_children():
            self.flow.remove(child)

        entries: list[dict] = []
        for section_key, _title, section_entries in self.catalog.sections:
            if section_key == key:
                entries = section_entries
                break

        if not entries:
            label = Gtk.Label(label="Nada aqui ainda.")
            label.get_style_context().add_class("empty")
            self.flow.add(label)
            self.flow.show_all()
            return

        # "recentes" is in most-recent-first order and sorting it would
        # throw away the only thing it knows.
        if key in ("recentes", "todos", "sistema"):
            ordered = entries
        else:
            ordered = sorted(entries, key=lambda e: (not e["installed"], e["name"].lower()))

        for entry in ordered:
            self.flow.add(self._make_tile(entry))

        self.flow.show_all()
        first = self.flow.get_child_at_index(0)
        if first is not None:
            self.flow.select_child(first)
            first.grab_focus()

    # school page ------------------------------------------------------------
    #  The services used to be a second 280px sidebar. Beside the new one that
    #  is two columns of navigation before any content starts, on a 1366-wide
    #  school laptop that leaves the page itself under half the screen. They are
    #  a row of pills above the view instead: seven short names fit across, and
    #  the web page gets the whole width.
    def _build_school_page(self) -> Gtk.Widget:
        page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)

        picker = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)

        self.school_buttons = []
        for index, (name, url, desc) in enumerate(self.school_links):
            button = Gtk.Button(label=name)
            button.get_style_context().add_class("service")
            button.set_relief(Gtk.ReliefStyle.NONE)
            button.set_can_focus(False)
            button.set_tooltip_text(desc or url)
            button.connect("clicked", lambda _b, i=index: self.open_school(i))
            picker.pack_start(button, False, False, 0)
            self.school_buttons.append(button)

        # A fork adding services, or simply a narrow screen, must not push the
        # last pill off the edge with no way to reach it.
        # The class goes on the scroller, not the row inside it: the scrollbar
        # is the scroller's own child, so a rule hung off the inner box would
        # never reach it.
        picker_scroller = Gtk.ScrolledWindow()
        picker_scroller.get_style_context().add_class("services")
        picker_scroller.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.NEVER)
        picker_scroller.add(picker)

        # Outside the scroller. Nine services already overflow 1366px, so a
        # button packed at the end of the scrolling row sat past the right edge:
        # the way out to a real browser was reachable only by scrolling a strip
        # that does not look scrollable. Pinned here it is always on screen.
        external = Gtk.Button(label="Abrir no navegador")
        external.get_style_context().add_class("service")
        external.get_style_context().add_class("service-external")
        external.set_relief(Gtk.ReliefStyle.NONE)
        external.set_can_focus(False)
        external.connect("clicked", self.open_in_browser)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        row.get_style_context().add_class("servicerow")
        row.pack_start(picker_scroller, True, True, 0)
        row.pack_end(external, False, False, 0)
        page.pack_start(row, False, False, 0)

        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)

        if HAVE_WEBKIT:
            bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
            bar.get_style_context().add_class("webbar")
            for icon, callback in (
                ("go-previous-symbolic", lambda _b: self.web.go_back()),
                ("go-next-symbolic", lambda _b: self.web.go_forward()),
                ("view-refresh-symbolic", lambda _b: self.web.reload()),
                ("go-home-symbolic", lambda _b: self.open_school(self.school_index)),
            ):
                button = Gtk.Button.new_from_icon_name(icon, Gtk.IconSize.BUTTON)
                button.set_relief(Gtk.ReliefStyle.NONE)
                button.set_can_focus(False)
                button.connect("clicked", callback)
                bar.pack_start(button, False, False, 0)
            self.urllabel = Gtk.Label(xalign=0)
            self.urllabel.get_style_context().add_class("weburl")
            self.urllabel.set_ellipsize(Pango.EllipsizeMode.END)
            bar.pack_start(self.urllabel, True, True, 0)
            right.pack_start(bar, False, False, 0)

            self.web = WebKit2.WebView()
            settings = self.web.get_settings()
            settings.set_property("enable-developer-extras", False)
            self.web.connect(
                "load-changed",
                lambda view, _e: self.urllabel.set_text(view.get_uri() or ""),
            )
            self.web.connect("decide-policy", self._decide_policy)
            self.web.connect("create", self._on_create)
            right.pack_start(self.web, True, True, 0)
        else:
            self.web = None
            notice = Gtk.Label(
                label="O visualizador embutido não está disponível.\n"
                      "Escolha um serviço acima para abrí-lo no navegador."
            )
            notice.get_style_context().add_class("empty")
            notice.set_justify(Gtk.Justification.CENTER)
            right.pack_start(notice, True, True, 0)

        page.pack_start(right, True, True, 0)
        self.school_index = 0
        return page

    def _highlight_school(self, index: int) -> None:
        """Move the highlight without opening anything."""
        self.school_index = index
        for i, button in enumerate(self.school_buttons):
            context = button.get_style_context()
            if i == index:
                context.add_class("active")
            else:
                context.remove_class("active")

    def open_school(self, index: int) -> None:
        self._highlight_school(index)
        _name, url, _desc = self.school_links[index]
        if self.web is not None:
            self.web.load_uri(url)
        else:
            Gio.AppInfo.launch_default_for_uri(url, None)

    def open_in_browser(self, _button=None) -> None:
        url = self.school_links[self.school_index][1]
        if self.web is not None and self.web.get_uri():
            url = self.web.get_uri()
        Gio.AppInfo.launch_default_for_uri(url, None)

    def _decide_policy(self, _view, decision, decision_type) -> bool:
        # NEW_WINDOW_ACTION is the one that made Moodle feel broken. Moodle
        # opens resources - PDFs, files, external tools, anything it treats as
        # an attachment - with target="_blank". There is no second window to
        # open them in here, and WebKit's default for a new-window decision
        # with nowhere to put it is to drop it silently: the click did nothing
        # at all, no error and no navigation, while ordinary links worked.
        # There is only ever one view in this front end, so they load in it.
        new_window = decision_type == WebKit2.PolicyDecisionType.NEW_WINDOW_ACTION
        if not new_window and decision_type != WebKit2.PolicyDecisionType.NAVIGATION_ACTION:
            return False

        uri = decision.get_navigation_action().get_request().get_uri() or ""

        # Checked for both kinds of decision: the Google login is reached from
        # a new-window link often enough that handling it only on ordinary
        # navigation would let it through to the dead-end block page.
        if urllib.parse.urlsplit(uri).hostname in SSO_HOSTS:
            decision.ignore()
            Gio.AppInfo.launch_default_for_uri(uri, None)
            self.notify(
                "O login do Google não funciona dentro do visualizador embutido.\n"
                "Continue no navegador que acabou de abrir e depois volte para cá."
            )
            return True

        if new_window and uri:
            decision.ignore()
            self.web.load_uri(uri)
            return True
        return False

    def _on_create(self, _view, navigation_action):
        # Backstop for a window.open() that reaches the create stage without a
        # new-window policy decision first. Same rule: load it here, and hand
        # back no new view.
        request = navigation_action.get_request()
        uri = request.get_uri() if request is not None else ""
        if uri:
            GLib.idle_add(self.web.load_uri, uri)
        return None

    # navigation -------------------------------------------------------------
    def select_tab(self, index: int) -> None:
        if not self.tab_keys:
            return
        self.section_index = index % len(self.tab_keys)
        key = self.tab_keys[self.section_index]

        for i, button in enumerate(self.tab_buttons):
            context = button.get_style_context()
            if i == self.section_index:
                context.add_class("active")
            else:
                context.remove_class("active")

        # Not SECTION_TITLES: sections the catalog invents itself, "Recentes"
        # above all, are not in it and would come out as "Recentes" only by
        # luck of capitalisation - "escola-online" would come out "Escola-online".
        self.section_label.set_text(self.tab_titles[self.section_index])

        if hasattr(self, "search"):
            self._suppress_search = True
            self.search.set_text("")
            self._suppress_search = False
            self._needle = ""
            self._searching = False
            if hasattr(self, "no_results"):
                self.no_results.hide()
                self.flow_scroller.show()

        if key == "escola-online":
            self.stack.set_visible_child_name("escola-online")
            self.hint.set_text(
                "←→ trocar de serviço    Tab trocar de seção    Esc voltar ou sair"
                if HAVE_WEBKIT else
                "←→ trocar de serviço    Enter abrir no navegador    "
                "Tab trocar de seção    Esc sair"
            )
            if self.web is not None and not self.web.get_uri():
                self.open_school(0)
            elif self.web is None:
                self.open_school(self.school_index)
        else:
            self.stack.set_visible_child_name("apps")
            self.hint.set_text(
                "↑↓←→ navegar    Enter abrir    digite para procurar    Tab trocar de seção    Esc sair"
            )
            self.populate(key)

    @staticmethod
    def section_for(start: str, keys: list[str], titles: list[str]) -> int | None:
        """Which section --category asked for, or None.

        Matched against the section's name on screen as well as its key,
        because those are not the same word and the visible one is what anybody
        would type. The keys come from the catalog filenames - the games live in
        20-gaming.list, so the key is "gaming" - while the section is called
        Jogos everywhere a person can see it. `ifos jogos` and the Big Picture
        session both ask for "jogos", matched nothing at all, and opened
        silently on whatever section happened to be first.
        """
        wanted = fold(start)
        if not wanted:
            return None
        for index, key in enumerate(keys):
            title = fold(titles[index]) if index < len(titles) else ""
            if key.lower().startswith(wanted) or (title and title.startswith(wanted)):
                return index
        return None

    def switch_section(self, delta: int) -> None:
        self.select_tab(self.section_index + delta)

    # actions ----------------------------------------------------------------
    def on_activate(self, _flow, child) -> None:
        tile = child.get_child()
        entry = getattr(tile, "entry", None)
        if entry is None:
            return

        if entry["kind"] == "action":
            self.spawn(entry["command"])
            if entry["command"].split()[0] in KEEP_LAUNCHER_OPEN:
                return
            Gtk.main_quit()
            return

        if not entry["installed"]:
            self.install(entry)
            return

        # Recorded before launching rather than after: info.launch() is followed
        # immediately by main_quit(), and there is no "after" to record in.
        self.catalog.remember(entry)

        info = getattr(tile, "appinfo", None) or self.catalog.find_appinfo(entry)

        # On a laptop with two graphics chips, send games to the fast one.
        # Everything renders on the integrated chip by default, which is what
        # makes the battery last and is wrong for exactly one kind of program.
        # The launcher already knows which entries are games, so nobody has to
        # be told about prime-run, or discover that their machine has been
        # running everything on the slow chip the whole time.
        # _prefers_dgpu first: it is a dictionary lookup, and asking it before
        # shelling out to lspci means the ordinary case of starting something
        # that is not a game never runs the check at all.
        if self._prefers_dgpu(entry, info) and self._can_offload():
            command = self._command_for(entry, info)
            if command:
                self.launch_watched(entry["name"], "ifos-gpu run " + command)
                return

        command = self._command_for(entry, info)
        if command is None:
            command = next((p for p in entry.get("packages", []) if shutil.which(p)), None)
        if command:
            self.launch_watched(entry["name"], command)
        else:
            self.notify("Não foi possível iniciar %s." % entry["name"])

    # ── starting something, and noticing when it does not start ──────────────
    #  This used to fire and forget: Popen, then main_quit on the next line.
    #  When the program failed - Steam without its 32-bit libraries is the one
    #  that keeps happening - the launcher vanished and nothing else appeared,
    #  and the only way to find out why was to know the program's name and run
    #  it in a terminal. That is not something to ask of somebody who has never
    #  opened one.
    #
    #  So: start it, hide the window, and watch for a second and a half. A
    #  program that is still running by then has started, and the launcher
    #  quits as before. One that has already exited non-zero has failed, and its
    #  own error message is worth more than anything this could invent.
    LAUNCH_GRACE_MS = 1500

    def launch_watched(self, name: str, command: str) -> None:
        try:
            proc = subprocess.Popen(
                ["/bin/sh", "-c", command],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.PIPE,
                start_new_session=True,
            )
        except OSError as exc:
            self.notify("Falha ao executar %s:\n%s" % (name, exc))
            return

        self.hide()
        GLib.timeout_add(self.LAUNCH_GRACE_MS, self._after_launch, proc, name)

    def _after_launch(self, proc, name: str) -> bool:
        if proc.poll() is None or proc.returncode == 0:
            Gtk.main_quit()
            return False

        # It failed. Read whatever it said, and put the window back so there is
        # something to read it in.
        try:
            _out, err = proc.communicate(timeout=2)
            message = (err or b"").decode("utf-8", "replace").strip()
        except (subprocess.SubprocessError, ValueError):
            message = ""
        self.show()
        self.present()
        self._report_failure(name, message)
        return False

    def _report_failure(self, name: str, message: str) -> None:
        # The last few lines: the useful part of a failure is at the end, and a
        # wall of output is not something anybody reads.
        tail = "\n".join(message.splitlines()[-6:]) if message else ""
        body = ("%s fechou logo depois de abrir.\n\n" % name)
        if tail:
            body += tail
        else:
            body += ("O programa não deixou nenhuma mensagem.\n"
                     "Se for um jogo, verifique em ifos-software → Hardware se o\n"
                     "driver de vídeo da sua placa está instalado.")
        self.notify(body)

    # ── the fast graphics chip, without being asked ──────────────────────────
    def _can_offload(self) -> bool:
        """Is there a second, faster graphics chip? Asked once, on first need."""
        if self._offload_gpu is None:
            self._offload_gpu = self._detect_offload()
        return self._offload_gpu

    @staticmethod
    def _detect_offload() -> bool:
        """True on a laptop with a second, faster graphics chip."""
        try:
            return subprocess.run(
                ["ifos-gpu", "--has-dgpu"], stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL, timeout=5,
            ).returncode == 0
        except (OSError, subprocess.SubprocessError):
            return False

    @staticmethod
    def _prefers_dgpu(entry: dict, info) -> bool:
        # The catalog already sorts games into their own section, which is the
        # whole answer for anything installed through IFOS.
        if entry.get("category") == "gaming":
            return True
        # And the desktop-entry standard has a key for exactly this, which Steam
        # and Lutris set on the shortcuts they generate for individual games.
        if info is not None:
            try:
                return bool(info.get_boolean("PrefersNonDefaultGPU"))
            except (AttributeError, TypeError):
                return False
        return False

    @staticmethod
    def _command_for(entry: dict, info) -> str | None:
        """The command line to run, with the desktop-entry field codes removed."""
        line = None
        if info is not None:
            try:
                line = info.get_commandline()
            except AttributeError:
                line = None
        if not line:
            line = next((p for p in entry.get("packages", []) if shutil.which(p)), None)
        if not line:
            return None
        # %u %U %f %F %i %c %k are placeholders the launcher has nothing to put
        # in; left in place they are passed to the game as literal arguments.
        return re.sub(r"%[a-zA-Z]", "", line).strip()

    def spawn(self, command: str) -> None:
        try:
            subprocess.Popen(["/bin/sh", "-c", command], start_new_session=True)
        except OSError as exc:
            self.notify("Falha ao executar: %s" % exc)

    def install(self, entry: dict) -> None:
        terminal = next((t for t in ("xfce4-terminal", "alacritty", "xterm")
                         if shutil.which(t)), None)
        if terminal is None:
            self.notify("Nenhum terminal disponível para instalar.")
            return
        try:
            proc = subprocess.Popen(
                [terminal, "-x" if terminal == "xfce4-terminal" else "-e",
                 "ifos-software", "--install", entry["name"]],
                start_new_session=True,
            )
        except OSError as exc:
            self.notify("Falha ao instalar: %s" % exc)
            return

        # Deliberately NOT quitting here. In the Big Picture session the
        # launcher is the session - i3 runs `ifos-launcher; i3-msg exit` - so
        # closing it took the whole session down and killed the install
        # terminal along with it, part way through installing. The same shape
        # of bug as locking the screen from here used to be.
        #
        # Waiting for the terminal also means the tile can stop saying INSTALAR
        # once the thing is actually installed, instead of until the launcher is
        # next opened.
        GLib.timeout_add_seconds(2, self._watch_install, proc)

    def _watch_install(self, proc) -> bool:
        if proc.poll() is None:
            return True                      # still installing
        self.catalog.refresh_installed()
        if not self._searching:
            self.populate(self.tab_keys[self.section_index])
        return False

    def notify(self, message: str) -> None:
        dialog = Gtk.MessageDialog(
            transient_for=self, modal=True,
            message_type=Gtk.MessageType.INFO,
            buttons=Gtk.ButtonsType.OK, text=message,
        )
        # Without this it is drawn by adw-gtk3 in its own grey, floating on a
        # full-screen green launcher - it reads as a piece of another program
        # rather than as this one having something to say.
        dialog.get_style_context().add_class("ifos-dialog")
        dialog.set_title("IFOS")
        dialog.run()
        dialog.destroy()

    def on_key(self, _widget, event) -> bool:
        key = event.keyval

        # Type-to-search from anywhere, as long as it is a plain character and
        # the search box does not already have focus.
        if (self.stack.get_visible_child_name() == "apps"
                and not self.search.has_focus()
                and not (event.state & (Gdk.ModifierType.CONTROL_MASK
                                        | Gdk.ModifierType.MOD1_MASK))):
            char = Gdk.keyval_to_unicode(key)
            if char and chr(char).isprintable() and chr(char) != " ":
                self.search.grab_focus()
                self.search.set_text(self.search.get_text() + chr(char))
                self.search.set_position(-1)
                return True

        if key == Gdk.KEY_Escape:
            # Clear a search before leaving, so Esc never loses the whole view
            # in one keypress.
            if self.stack.get_visible_child_name() == "apps" and self.search.get_text():
                self.search.set_text("")
                first = self.flow.get_child_at_index(0)
                if first is not None:
                    first.grab_focus()
                return True
            if self.stack.get_visible_child_name() == "escola-online" and self.web is not None:
                if self.web.can_go_back():
                    self.web.go_back()
                    return True
            Gtk.main_quit()
            return True
        if key in (Gdk.KEY_Tab, Gdk.KEY_Page_Down):
            self.switch_section(1)
            return True
        if key in (Gdk.KEY_ISO_Left_Tab, Gdk.KEY_Page_Up):
            self.switch_section(-1)
            return True

        # On the school page Tab is spent switching sections and the pills are
        # not in the focus chain, so without this there is no way at all to
        # change service from the keyboard - which in the Big Picture session,
        # where there may be no mouse, meant Moodle or nothing.
        if (self.stack.get_visible_child_name() == "escola-online"
                and self.school_buttons
                and not (self.web is not None and self.web.has_focus())):
            if key in (Gdk.KEY_Left, Gdk.KEY_Right):
                step = 1 if key == Gdk.KEY_Right else -1
                index = (self.school_index + step) % len(self.school_buttons)
                if self.web is not None:
                    # Loads in place: moving along the row *is* opening it.
                    self.open_school(index)
                else:
                    # Without the embedded view, opening means launching a
                    # browser. Arrowing along the row must not spawn one window
                    # per keypress, so here the arrows only move the highlight
                    # and Enter is what opens.
                    self._highlight_school(index)
                return True
            if key in (Gdk.KEY_Return, Gdk.KEY_KP_Enter) and self.web is None:
                self.open_school(self.school_index)
                return True
        return False

    # gamepad ----------------------------------------------------------------
    #  Three things were wrong with reading the pad, and all of them show up in
    #  the Big Picture session, where the launcher *is* the session:
    #
    #  It looked for a controller once, at startup. Plugging one in afterwards -
    #  which is the normal order, since the session starts when the machine does
    #  - was never noticed. It is polled for now.
    #
    #  Unplugging one left the watch in place on a dead descriptor, which then
    #  reported readable forever and returned nothing: a core spinning at 100%
    #  until the launcher was closed. The watch is dropped and the search for a
    #  controller resumes.
    #
    #  And events were read one fixed-size block at a time with a short read
    #  silently discarded. A read that returned part of an event threw the
    #  stream out of alignment permanently - every later event decoded as
    #  garbage, so the pad appeared to work and then stopped. Bytes are buffered
    #  and consumed eight at a time instead.
    GAMEPAD_EVENT = 8               # struct js_event: __u32, __s16, __u8, __u8
    GAMEPAD_POLL_SECONDS = 3

    def attach_gamepad(self) -> None:
        self._pad_stream = None
        self._pad_watch = 0
        self._pad_buf = b""
        self._open_gamepad()
        GLib.timeout_add_seconds(self.GAMEPAD_POLL_SECONDS, self._poll_gamepad)

    def _poll_gamepad(self) -> bool:
        if self._pad_stream is None:
            self._open_gamepad()
        return True                 # keep looking, for as long as we are open

    def _open_gamepad(self) -> None:
        for index in range(4):
            path = "/dev/input/js%d" % index
            if not os.path.exists(path):
                continue
            try:
                stream = open(path, "rb", buffering=0)
                os.set_blocking(stream.fileno(), False)
            except OSError:
                continue
            self._pad_stream = stream
            self._pad_buf = b""
            self._pad_watch = GLib.io_add_watch(
                stream.fileno(),
                GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR | GLib.IO_NVAL,
                self._on_gamepad, stream,
            )
            return

    def _drop_gamepad(self) -> None:
        if self._pad_stream is not None:
            try:
                self._pad_stream.close()
            except OSError:
                pass
        self._pad_stream = None
        self._pad_watch = 0
        self._pad_buf = b""

    def _on_gamepad(self, _fd, condition, stream) -> bool:
        if condition & (GLib.IO_HUP | GLib.IO_ERR | GLib.IO_NVAL):
            self._drop_gamepad()
            return False            # removing the watch is what stops the spin

        try:
            chunk = stream.read(self.GAMEPAD_EVENT * 16)
        except (BlockingIOError, InterruptedError):
            return True
        except OSError:
            self._drop_gamepad()
            return False

        if not chunk:               # end of file: the controller is gone
            self._drop_gamepad()
            return False

        self._pad_buf += chunk
        while len(self._pad_buf) >= self.GAMEPAD_EVENT:
            event = self._pad_buf[: self.GAMEPAD_EVENT]
            self._pad_buf = self._pad_buf[self.GAMEPAD_EVENT :]
            self._handle_gamepad_event(event)
        return True

    def _handle_gamepad_event(self, data: bytes) -> None:
        _time, value, ev_type, number = struct.unpack("<IhBB", data)
        if ev_type & 0x01 and value == 1:
            if number == 0:
                selected = self.flow.get_selected_children()
                if selected:
                    self.on_activate(self.flow, selected[0])
            elif number == 1:
                Gtk.main_quit()
            elif number == 4:
                self.switch_section(-1)
            elif number == 5:
                self.switch_section(1)
        elif ev_type & 0x02 and abs(value) >= 20000:
            if number in (0, 6):
                self.flow.child_focus(
                    Gtk.DirectionType.RIGHT if value > 0 else Gtk.DirectionType.LEFT
                )
            elif number in (1, 7):
                self.flow.child_focus(
                    Gtk.DirectionType.DOWN if value > 0 else Gtk.DirectionType.UP
                )


def main() -> int:
    parser = argparse.ArgumentParser(description="IFOS full-screen launcher")
    parser.add_argument("--category", help="section to open on start (escola, jogos, ...)")
    parser.add_argument("--no-gamepad", action="store_true", help="skip gamepad input")
    args = parser.parse_args()

    window = Launcher(Catalog(), args.category, not args.no_gamepad)
    window.show_all()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
