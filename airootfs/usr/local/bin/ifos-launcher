#!/usr/bin/env python3
# ─────────────────────────────────────────────────────────────────────────────
#  ifos-launcher — full-screen front end for everything on the machine
#
#  Gamescope puts a game in a controlled fullscreen session. This does the same
#  for the whole purpose of IFOS: one screen, big tiles, navigable with keyboard
#  or gamepad, covering the school software and the games equally — plus a built
#  in Moodle front end so the AVEA is one keypress away with no browser
#  installed at all.
#
#  Sections come from the same catalog ifos-software uses
#  (/usr/share/ifos/apps.d/*.list), so anything added there appears here too.
#  School web services come from /usr/share/ifos/escola.list.
#
#      ifos-launcher                    open the launcher
#      ifos-launcher --category jogos   start on a given section
#      ifos-launcher --no-gamepad
#
#  Navigation:  arrows / d-pad move · Enter or A opens · Tab or shoulder
#               buttons change section · Esc or B goes back / closes
# ─────────────────────────────────────────────────────────────────────────────
from __future__ import annotations

import argparse
import os
import re
import shlex
import shutil
import struct
import subprocess
import sys
import unicodedata
import urllib.parse
from datetime import datetime

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gdk, Gio, GLib, Gtk, Pango  # noqa: E402

# WebKit is what makes the Moodle tab an actual front end rather than a
# bookmark. It is optional: without it the school page degrades to link tiles
# that open in whatever browser is installed.
HAVE_WEBKIT = False
for _api in ("4.1", "4.0"):
    try:
        gi.require_version("WebKit2", _api)
        from gi.repository import WebKit2  # noqa: E402

        HAVE_WEBKIT = True
        break
    except (ValueError, ImportError):
        continue

# What this account has opened, most recent first. Lives in ~/.config/ifos
# rather than anywhere under the launcher's own configuration, because that
# directory is not part of /etc/skel and so survives `ifos-update --dotfiles`,
# which replaces the rest of ~/.config wholesale.
RECENT_FILE = os.path.join(
    os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config")),
    "ifos", "recent",
)
RECENT_MAX = 12

CATALOG_DIR = os.environ.get("IFOS_CATALOG_DIR", "/usr/share/ifos/apps.d")
SCHOOL_LIST = os.environ.get("IFOS_SCHOOL_LIST", "/usr/share/ifos/escola.list")
WALLPAPER = "/usr/share/backgrounds/ifos.png"

# Google refuses to complete sign-in inside any embedded/non-standard browser,
# WebKitGTK included - it shows its own dead-end block page rather than the
# login form, and no amount of user-agent spoofing changes that. IFMS Moodle
# uses Google as its identity provider, so the only way in is to kick that one
# navigation out to the user's real system browser.
SSO_HOSTS = {"accounts.google.com"}

# Actions that must leave the launcher running. Locking the screen, powering
# down and switching the theme all continue without it, and in the Big Picture
# session closing the launcher ends the session - so locking the screen there
# used to log you out. Matched on the command's first word rather than by
# substring, which is what silently broke when i3lock became ifos-lock.
KEEP_LAUNCHER_OPEN = {"systemctl", "ifos-lock", "ifos-theme",
                      "ifos-update-terminal", "ifos-term",
                      "~/.config/i3/scripts/screens.sh"}

