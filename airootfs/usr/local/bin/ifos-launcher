# One name per section, with fallbacks after it. IFOS ships Papirus, which has
# all of the first choices; the fallbacks are for a machine where the theme did
# not install or a fork swapped it, because an icon name a theme does not have
# is not drawn as nothing - GTK draws the broken-image glyph, and a sidebar of
# those looks like the launcher is faulty rather than plain.
SECTION_ICONS = {
    "recentes": ("document-open-recent", "document-open-recent-symbolic", "history"),
    "escola": ("applications-education", "accessories-dictionary", "text-x-generic"),
    "escola-online": ("applications-internet", "web-browser", "network-workgroup"),
    "browsers": ("web-browser", "applications-internet", "network-workgroup"),
    "gaming": ("applications-games", "input-gaming"),
    "development": ("applications-development", "text-x-script", "utilities-terminal"),
    "media": ("applications-multimedia", "video-x-generic"),
    "musica": ("audio-x-generic", "multimedia-audio-player"),
    "office": ("applications-office", "x-office-document", "text-x-generic"),
    "utilities": ("applications-utilities", "applications-system", "preferences-system"),
    "hardware": ("preferences-desktop-peripherals", "computer", "applications-system"),
}
SECTION_ICON_FALLBACK = "application-x-executable"


def fold(text: str) -> str:
    """Lowercase and strip accents, for comparing what someone typed.

    Searching was accent-sensitive, in a system whose interface is Portuguese:
    "musica" did not match Música, "programacao" did not match Programação,
    "utilitarios" did not match Utilitários. Typing the accents is possible on
    the ABNT2 keyboard this ships with and nobody does it inside a search box.
    """
    return "".join(
        c for c in unicodedata.normalize("NFD", text.lower())
        if not unicodedata.combining(c)
    )


def section_icon(key: str) -> str:
    """The first name for `key` the icon theme can actually draw."""
    theme = Gtk.IconTheme.get_default()
    for name in SECTION_ICONS.get(key, ()):
        if theme.has_icon(name):
            return name
    return SECTION_ICON_FALLBACK

