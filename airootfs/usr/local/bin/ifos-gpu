#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  ifos-gpu — which graphics chip this machine has, and how to use the fast one
#
#      ifos-gpu              show the graphics chips and how to reach them
#      ifos-gpu run CMD...   run CMD on the dedicated card
#      ifos-gpu --has-dgpu   exit 0 if there is a dedicated card to offload to
#
#  A laptop with two graphics chips renders everything on the integrated one.
#  That is the right default - it is why the battery lasts - but it means games
#  run on the slow chip unless something says otherwise, and nothing on the
#  screen ever says so. The machine is simply slow, with nothing to point at.
#
#  The mechanism is prime-run, from nvidia-prime. It is a three-line wrapper
#  that sets three environment variables, so when it is missing this sets them
#  directly rather than refusing to work.
# ─────────────────────────────────────────────────────────────────────────────
set -uo pipefail

c_reset=$'\033[0m'; c_b=$'\033[1m'; c_grn=$'\033[1;32m'
c_dim=$'\033[2m'; c_yel=$'\033[1;33m'

gpu_lines() {
    lspci 2>/dev/null | grep -Ei 'vga compatible controller|3d controller|display controller'
}

# A discrete card shows up as a second display device. On Intel+NVIDIA and
# AMD+NVIDIA laptops the NVIDIA one is the discrete half; "3D controller"
# rather than "VGA compatible controller" is the usual giveaway, because the
# discrete chip has nothing plugged into it.
has_dgpu() {
    local lines
    lines=$(gpu_lines) || return 1
    [[ $(grep -c . <<<"$lines") -ge 2 ]] || return 1
    grep -qi 'nvidia' <<<"$lines"
}

offload() {     # offload <command...>
    if command -v prime-run >/dev/null 2>&1; then
        exec prime-run "$@"
    fi
    # What prime-run itself does. Spelled out so a machine that has the driver
    # but not the wrapper still works.
    export __NV_PRIME_RENDER_OFFLOAD=1
    export __GLX_VENDOR_LIBRARY_NAME=nvidia
    export __VK_LAYER_NV_optimus=NVIDIA_only
    exec "$@"
}

case ${1:-} in
    --has-dgpu) has_dgpu && exit 0 || exit 1 ;;
    -h|--help)  sed -n '3,9p' "$0" | sed 's/^# \?//'; exit 0 ;;
    run)
        shift
        (( $# )) || { echo "ifos-gpu: run needs a command" >&2; exit 1; }
        offload "$@" ;;
esac

# ── Report ───────────────────────────────────────────────────────────────────
printf '\n%s  Placas de vídeo neste computador%s\n\n' "$c_b" "$c_reset"

mapfile -t gpus < <(gpu_lines | sed 's/^[0-9a-f:.]* //')
if (( ! ${#gpus[@]} )); then
    printf '  Nenhuma detectada (lspci não encontrou nada).\n\n'
    exit 0
fi

for line in "${gpus[@]}"; do
    role="integrada"
    grep -qi 'nvidia' <<<"$line" && has_dgpu && role="dedicada"
    printf '    %s%s%s\n      %s%s%s\n' "$c_grn" "${line%%:*}" "$c_reset" \
           "$c_dim" "${line#*: }" "$c_reset"
    printf '      %s\n\n' "$role"
done

if has_dgpu; then
    if ! command -v prime-run >/dev/null 2>&1; then
        printf '  %s!%s O pacote nvidia-prime não está instalado.\n' "$c_yel" "$c_reset"
        printf '    Instale em: ifos-software → Hardware → NVIDIA\n\n'
    fi
    cat <<EOF
  ${c_b}Você não precisa fazer nada.${c_reset} Os jogos abertos pelo IFOS Launcher já
  vão para a placa dedicada sozinhos; o resto continua na integrada, que é o
  que faz a bateria durar.

  Só se precisar abrir algo pesado por fora do launcher:

    ${c_b}ifos-gpu run <programa>${c_reset}

EOF
else
    printf '  Só uma placa de vídeo: tudo já roda nela, não há o que escolher.\n\n'
fi
