#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────────
#  ifos-update-terminal — run ifos-update in a terminal window.
#
#  The launcher's "Atualizar o IFOS" tile points here rather than at
#  ifos-update itself. ifos-update needs a terminal: it asks for a sudo
#  password, prints what it is doing for several minutes, and finishes with a
#  fifteen second countdown that can be cancelled with Ctrl+C. Started without
#  one it would appear to do nothing at all, and then reboot the machine.
#
#  It also has to survive the launcher closing, so the terminal is started in
#  its own session.
# ─────────────────────────────────────────────────────────────────────────────
set -u

TERMINAL=""
for candidate in xfce4-terminal alacritty xterm; do
    command -v "$candidate" >/dev/null 2>&1 && { TERMINAL=$candidate; break; }
done

if [[ -z $TERMINAL ]]; then
    command -v notify-send >/dev/null 2>&1 &&
        notify-send -a IFOS -u critical "Atualizar o IFOS" \
            "Nenhum terminal disponível. Execute 'ifos-update' na linha de comando."
    exit 1
fi

# xfce4-terminal needs -x to pass a command with arguments; the others use -e.
case $TERMINAL in
    xfce4-terminal) RUN=(-T "Atualizar o IFOS" -x) ;;
    alacritty)      RUN=(-t "Atualizar o IFOS" -e) ;;
    *)              RUN=(-T "Atualizar o IFOS" -e) ;;
esac

# `bash -lc` rather than calling ifos-update directly: it ends by asking a
# question, and when the update finishes or fails the window should stay long
# enough to read why rather than vanishing.
exec setsid "$TERMINAL" "${RUN[@]}" bash -lc '
    ifos-update
    status=$?
    if (( status != 0 )); then
        printf "\n  A atualização terminou com erro (código %s).\n" "$status"
    fi
    read -rp "  Pressione Enter para fechar… "
'
