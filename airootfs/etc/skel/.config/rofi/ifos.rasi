/* IFOS theme for rofi.
   Shipped as a real file: the config used to reference @theme "catppuccin-mocha",
   a theme that does not exist in rofi's built-in set, so rofi failed to start.
   Colours are swapped in place by `ifos-theme`. */

* {
    base:       #10241d;
    mantle:     #0a1a14;
    surface0:   #1b3a2e;
    surface1:   #24503f;
    text:       #e8f5e9;
    subtext0:   #b9d4c6;
    overlay0:   #7fa392;
    blue:       #00a86b;
    mauve:      #7ed957;
    red:        #f38ba8;

    background-color:   transparent;
    text-color:         @text;
    margin:             0;
    padding:            0;
    spacing:            0;
}

window {
    background-color:   @base;
    border:             2px;
    border-color:       @blue;
    border-radius:      12px;
    width:              620px;
    padding:            0;
}

mainbox {
    padding:            14px;
    spacing:            12px;
}

inputbar {
    background-color:   @surface0;
    border-radius:      8px;
    padding:            10px 14px;
    spacing:            10px;
    children:           [ prompt, entry ];
}

prompt {
    text-color:         @blue;
    vertical-align:     0.5;
}

entry {
    placeholder:        "search…";
    placeholder-color:  @overlay0;
    vertical-align:     0.5;
}

listview {
    columns:            1;
    lines:              9;
    fixed-height:       false;
    scrollbar:          false;
    spacing:            4px;
}

element {
    padding:            9px 12px;
    border-radius:      8px;
    spacing:            12px;
}

element normal.normal   { text-color: @text; }
element alternate.normal { text-color: @text; }
element selected.normal {
    background-color:   @blue;
    text-color:         @base;
}
element urgent.normal   { text-color: @red; }

element-icon {
    size:               1.15em;
    vertical-align:     0.5;
}

element-text {
    vertical-align:     0.5;
    highlight:          bold @mauve;
}

message {
    background-color:   @surface0;
    border-radius:      8px;
    padding:            10px;
}

textbox {
    text-color:         @subtext0;
}
