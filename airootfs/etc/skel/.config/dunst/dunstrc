[global]
    monitor = 0
    follow = mouse
    width = 340
    # dunst 1.12 replaced the single-number height and NxN offset with tuples;
    # the old forms still work but warn on every start.
    height = (0, 180)
    origin = top-right
    offset = (12, 12)
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    frame_width = 2
    frame_color = "#00a86b"
    font = JetBrainsMono Nerd Font 10
    format = "<b>%s</b>\n%b"
    corner_radius = 8
    gap_size = 6
    icon_theme = "Papirus-Dark, Adwaita"
    enable_recursive_icon_lookup = true

[urgency_low]
    background = "#10241d"
    foreground = "#e8f5e9"
    timeout = 5

[urgency_normal]
    background = "#10241d"
    foreground = "#e8f5e9"
    timeout = 8

[urgency_critical]
    background = "#f38ba8"
    foreground = "#1e1e2e"
    frame_color = "#f38ba8"
    timeout = 0
