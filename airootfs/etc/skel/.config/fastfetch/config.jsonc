{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  // The IFOS wordmark, generated by tools/gen-artwork.py from the same glyphs
  // as the wallpaper and the boot splash. "file" (not "file-raw") so the $1/$2
  // colour placeholders in it are honoured.
  "logo": {
    "type": "file",
    "source": "/usr/share/ifos/logo.txt",
    "color": {
      "1": "green",
      "2": "white"
    },
    "padding": { "top": 1, "left": 2 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "green" }
  },
  "modules": [
    { "type": "title", "fqdn": false },
    "separator",
    { "type": "os",       "key": " OS",     "keyColor": "green" },
    { "type": "kernel",   "key": " Kernel", "keyColor": "green" },
    { "type": "uptime",   "key": "󱑍 Uptime", "keyColor": "green" },
    { "type": "packages", "key": " Pkgs",   "keyColor": "cyan" },
    { "type": "shell",    "key": " Shell",  "keyColor": "cyan" },
    { "type": "wm",       "key": " WM",     "keyColor": "cyan" },
    { "type": "terminal", "key": " Term",   "keyColor": "cyan" },
    { "type": "cpu",      "key": " CPU",    "keyColor": "yellow" },
    { "type": "gpu",      "key": "󰍹 GPU",    "keyColor": "yellow" },
    { "type": "memory",   "key": " RAM",    "keyColor": "yellow" },
    { "type": "disk",     "key": "󰋊 Disk",   "keyColor": "magenta", "folders": "/" },
    { "type": "localip",  "key": "󰩠 IP",     "keyColor": "magenta" },
    "separator",
    { "type": "colors", "symbol": "circle", "paddingLeft": 1 }
  ]
}
