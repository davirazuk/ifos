# ─────────────────────────────────────────────────────────────────────────────
#  IFOS — game controllers
#
#  A controller plugged into a fresh Arch install half works, and the half that
#  is missing is invisible. The kernel driver claims it, so it shows up in
#  /dev/input/js0 and the buttons do something - but SDL, which is what almost
#  every game and emulator actually reads, also wants /dev/hidraw* for the
#  parts that are not buttons: rumble, the gyroscope, the light bar, the
#  DualSense's adaptive triggers, and the report that says *which* controller
#  this is so the game can draw the right button prompts.
#
#  /dev/hidraw* is root-only. systemd grants the logged-in user access to input
#  devices through its uaccess tag, but nothing tags hidraw, so the controller
#  ends up as a nameless generic pad with no rumble and Playstation buttons
#  labelled A/B/X/Y. That is not a failure anybody reports as a bug; it just
#  feels cheap.
#
#  These rules tag the hidraw node of the controllers students actually bring.
#  Matched by product rather than by vendor wherever the vendor also makes
#  other things - Sony sells cameras, Microsoft sells keyboards - and by vendor
#  where the vendor makes nothing but controllers.
#
#  Two matches per device: ATTRS{idVendor}/{idProduct} for USB, and KERNELS for
#  Bluetooth, where there is no USB device to carry those attributes and the
#  HID device name is the only thing that identifies it. That name looks like
#  0005:054C:0CE6.0003 - bus, vendor, product, instance - in uppercase hex.
#
#  Steam ships rules of its own that cover much of this; these exist so that a
#  machine without Steam - an emulator, a Godot project, the IFOS launcher's
#  own gamepad support - behaves the same way.
# ─────────────────────────────────────────────────────────────────────────────

ACTION!="add|change", GOTO="ifos_controllers_end"
KERNEL!="hidraw*", GOTO="ifos_controllers_end"

# ── Sony ─────────────────────────────────────────────────────────────────────
# DualSense (PS5) and DualSense Edge. The Edge reports a different product id
# and is otherwise the same device to userspace.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0ce6", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0df2", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*054C:0CE6*", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*054C:0DF2*", MODE="0660", TAG+="uaccess"

# DualShock 4: original, the 2016 revision, and the USB dongle.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="05c4", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="09cc", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0ba0", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*054C:05C4*", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*054C:09CC*", MODE="0660", TAG+="uaccess"

# DualShock 3 / SIXAXIS. Still common second-hand, and the one most likely to
# be in a lab drawer.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0268", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*054C:0268*", MODE="0660", TAG+="uaccess"

# ── Nintendo ─────────────────────────────────────────────────────────────────
# Switch Pro controller and the two Joy-Cons, which the kernel's hid-nintendo
# driver supports over both USB and Bluetooth.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="057e", ATTRS{idProduct}=="2009", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="057e", ATTRS{idProduct}=="2006", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="057e", ATTRS{idProduct}=="2007", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="057e", ATTRS{idProduct}=="2017", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*057E:2009*", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*057E:2006*", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*057E:2007*", MODE="0660", TAG+="uaccess"
# GameCube adapter, for the emulators in the catalog.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="057e", ATTRS{idProduct}=="0337", MODE="0660", TAG+="uaccess"

# ── Microsoft ────────────────────────────────────────────────────────────────
# Xbox One and Series controllers over Bluetooth, the Elite 2, and the wireless
# adapter. The wired ones go through xpad and need nothing here.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="045e", ATTRS{idProduct}=="02e0", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="045e", ATTRS{idProduct}=="02fd", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="045e", ATTRS{idProduct}=="0b05", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="045e", ATTRS{idProduct}=="0b13", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="045e", ATTRS{idProduct}=="0b20", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*045E:02E0*", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*045E:02FD*", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*045E:0B05*", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*045E:0B13*", MODE="0660", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*045E:0B20*", MODE="0660", TAG+="uaccess"

# ── Vendors that make nothing else ───────────────────────────────────────────
# 8BitDo, whose adapters and pads are the cheapest way to put a controller on a
# lab machine, and Valve, whose ids cover the Steam Controller and the Deck.
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="2dc8", MODE="0660", TAG+="uaccess"
SUBSYSTEM=="hidraw", ATTRS{idVendor}=="28de", MODE="0660", TAG+="uaccess"

LABEL="ifos_controllers_end"
